// This folder is the one plugin every host installs: the Agent Plugins manifest and MCP
// file, Claude Code's own manifest, and skills/hey-arti, which has its own reviews.
artf agent-plugin : files = {
  parts = [agent-focus-then-sweep, agent-hey-arti]
  path = "agent-plugin/"
  tags = ["type:plugin"]

  eval claude-code-installs : runtime(
      command = "python3",
      args = [
        "-I",
        "@{path agent-onramp/agent_plugin.py}",
        "claude",
        "@{path agent-plugin}",
        "@{path agent-claude-marketplace}",
      ],
      timeout_ms = 600000,
    ) = {
    title = "Claude Code installs the plugin with its skill and MCP server"
    instruction = "Install agent-plugin from agent-claude-marketplace into a disposable configuration of the installed Claude Code, and check that it validates and loads every skill of the folder and the artifactize MCP server for the session's project. The disposable host uses the process owner from agent-harness."
    inputs = [agent-claude-marketplace, agent-harness]
  }

  eval codex-installs : runtime(
      command = "python3",
      args = [
        "-I",
        "@{path agent-onramp/agent_plugin.py}",
        "codex",
        "@{path agent-plugin}",
        "@{path agent-codex-marketplace}",
      ],
      timeout_ms = 600000,
    ) = {
    title = "Codex installs the plugin with its skill and MCP server"
    instruction = "Install agent-plugin from agent-codex-marketplace into a disposable configuration of the installed Codex, and check that it loads every skill of the folder and launches the artifactize MCP server as `artifactize mcp`, which Codex starts in the installed plugin's folder. The disposable host uses the process owner from agent-harness."
    inputs = [agent-codex-marketplace, agent-harness]
  }
}
