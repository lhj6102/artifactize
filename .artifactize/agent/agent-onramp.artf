path = "harness/"
type = "files"
parts = ["agent-harness"]

[evals.follows-test-rules]
title = "The onramp's Python tests and harness entry points follow the test rules"
profile = { kind = "agent", backend = "codex", model = "gpt-6.2-sol", reasoning = "xhigh", timeout_ms = 1800000 }
red_at = "P1"

[evals.follows-test-rules.payload]
instruction = """
Read the TEST- rules of {rules-code-style}. Review the Python tests and harness \
entry points directly owned by {agent-onramp}. The nested {agent-harness} has its own test-rule review: do not duplicate it. \
Check every TEST- rule against observable boundaries, exact async states, controlled ordering or \
expiry times, read-only observations, owned cleanup, and declared executables and inputs. Report only what a rule item states: each finding names the item (or journey) it violates and points to a concrete place where that item's text is not met. An improvement the item's text does not require (a further split, a stronger type, an extra assertion, a scenario on an OS the item does not name) is not a finding."""
