tags = ["type:capture"]
path = "assets/capture/screenshots.mts"
type = "files"

[evals.records-scenes]
title = "The script captures scenes A, B and C from the real app"
profile = { kind = "agent", backend = "codex", model = "gpt-6.2-sol", reasoning = "high", timeout_ms = 1800000 }
red_at = "P1"

[evals.records-scenes.payload]
instruction = """
Read {media-screenshots-script}, its shared capture lifecycle in {media-capture-lifecycle}, the app's feature journeys in {desktop-ux-features}, and the app in {desktop-backend}, {desktop-ui} and {desktop-e2e} as far as the \
scenes need. Judge whether running the \
script captures each scene below from the real desktop app at 1920×1080, with real data made \
through the real CLI and nothing mocked:

A. Verify (J-BAR, J-PANE, J-BRANCH-RUNS, J-MAIN-RUN, J-GRAPH-COLOURS): the Pane with the \
example's branch and its Run timeline, the Run's graph with mixed verdicts (GREEN, RED, \
blocked and waiting for a person), and the Review button's waiting count in the bottom bar.
B. An Artifact's Detail (J-DETAIL, J-DETAIL-NEIGHBOURS) docked over the Run's graph on its \
Artifact tab: the Artifact between its neighbours, and its evals with their verdicts.
C. Switch to Review from the bottom bar, select the waiting sign-off in Review's Pane and \
claim it (J-BAR, J-REVIEW-LIST, J-HUMAN-CLAIM). Show its instruction, Tools and the finished \
notes tool run in the Tool log on the left, and Evaluation with the GREEN form on the right \
(J-HUMAN-LAYOUT, J-HUMAN-LOG, J-HUMAN-GREEN). Do not submit the review.

Check that each scene's selectors and actions reach the state the journey describes, that the \
script waits for that state rather than a fixed delay alone before capturing, and that it \
cleans up the app, the build and the project it made. Check also that every scene is captured."""
