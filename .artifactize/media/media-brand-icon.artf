tool artwork = {
  human open = builtin(
      op = "open",
      args = ["@{path self}"],
      description = "Open the original artwork of @{artf self} in the default image viewer.",
    )
}

artf media-brand-icon : artwork = {
  path = "assets/brand/artifactize-icon.svg"

  eval approved : human = {
    title = "The owner approves this artwork as the Artifactize icon"
    instruction = "Open @{artf media-brand-icon} with the open tool. Submit GREEN when the owner approves this artwork as the Artifactize icon; otherwise submit RED with an issue for each change required."
  }
}
