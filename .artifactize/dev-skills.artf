path = ".agents/skills/"
type = "files"
# The dev-master, dev-worker and release-master skills for Claude Code and Codex (.claude/skills links here).

[evals.correct]
title = "The development skills state today's commands, outcomes and CI correctly"
profile = { kind = "agent", backend = "codex", model = "gpt-6-luna", reasoning = "max", timeout_ms = 1800000 }
red_at = "P1"

[evals.correct.payload]
instruction = """
Read dev-master/SKILL.md, dev-worker/SKILL.md, release-master/SKILL.md and all three agents/openai.yaml of {dev-skills}.
Check that:
- every artifactize command, flag, selector, exit code, outcome name and output line they
  state matches {engine-cli};
- every CI job, informational job and workflow trigger they mention matches the workflows
  of {release-automation};
- the three skills agree with each other on the branch model, the main-green tag, the
  release/* and v* release flow, the verify command and the pull request note format;
- each SKILL.md has the frontmatter fields name, description and
  disable-model-invocation: true, and each openai.yaml sets policy.allow_implicit_invocation
  to false.
Judge accuracy and agreement only; an omission is not a finding. Each statement that is wrong or contradictory is a finding."""
