path = "crates/artifactize/"
type = "files"

[evals.follows-style]
title = "The CLI code follows the code checklist"
profile = { kind = "agent", backend = "codex", model = "gpt-6-luna", reasoning = "max", timeout_ms = 1800000 }
red_at = "P1"

[evals.follows-style.profile_variants]
sol-medium = { kind = "agent", backend = "codex", model = "gpt-6-luna", reasoning = "max", timeout_ms = 1800000 }
sol-max = { kind = "agent", backend = "codex", model = "gpt-6-luna", reasoning = "max", timeout_ms = 1800000 }
luna-max = { kind = "agent", backend = "codex", model = "gpt-6-luna", reasoning = "max", timeout_ms = 1800000 }

[evals.follows-style.payload]
instruction = """
Read the checklist {rules-code-style}. Then review the Rust code of {engine-cli} (src/ \
and Cargo.toml; tests/ for M-TAUTOLOGICAL-TESTS and every TEST- rule) against every item. Tool paths are relative to the Artifact, for example src/main.rs. Report only what a rule item states: each finding names the item (or journey) it violates and points to a concrete place where that item's text is not met. An improvement the item's text does not require (a further split, a stronger type, an extra assertion, a scenario on an OS the item does not name) is not a finding."""

[evals.follows-platform]
title = "The CLI code follows the platform checklist"
profile = { kind = "agent", backend = "codex", model = "gpt-6-luna", reasoning = "max", timeout_ms = 1800000 }
red_at = "P1"

[evals.follows-platform.profile_variants]
sol-medium = { kind = "agent", backend = "codex", model = "gpt-6-luna", reasoning = "max", timeout_ms = 1800000 }
sol-max = { kind = "agent", backend = "codex", model = "gpt-6-luna", reasoning = "max", timeout_ms = 1800000 }
luna-max = { kind = "agent", backend = "codex", model = "gpt-6-luna", reasoning = "max", timeout_ms = 1800000 }

[evals.follows-platform.payload]
instruction = """
Read the checklist {rules-platform}. Then review the Rust code of {engine-cli} (src/, \
tests/ and Cargo.toml) against every P- item. Tool paths are relative to the Artifact, for example src/main.rs. Report only what a rule item states: each finding names the item (or journey) it violates and points to a concrete place where that item's text is not met. An improvement the item's text does not require (a further split, a stronger type, an extra assertion, a scenario on an OS the item does not name) is not a finding."""

[evals.fmt]
title = "The Rust formatting check passes"
profile = { kind = "runtime", command = "cargo", args = ["fmt", "--check", "-p", "artifactize"], timeout_ms = 60000 }

[evals.fmt.payload]
instruction = "Check the formatting of {engine-cli}."

[evals.clippy]
title = "Clippy passes for every Rust target"
profile = { kind = "runtime", command = "cargo", args = ["clippy", "--locked", "-p", "artifactize", "--all-targets", "--", "-D", "warnings"], timeout_ms = 1800000 }

[evals.clippy.payload]
instruction = "Check every Rust target of {engine-cli} with {engine-core} with {engine-tools} with {engine-mcp} with the workspace {engine-cargo-manifest} and {engine-cargo-lock}, treating every clippy warning as an error."

[evals.tests]
title = "The Rust crate tests pass"
profile = { kind = "runtime", command = "cargo", args = ["test", "--locked", "-p", "artifactize"], timeout_ms = 1800000 }

[evals.tests.payload]
instruction = "Run the tests of {engine-cli} with {engine-core} with {engine-tools} with {engine-mcp} with the workspace {engine-cargo-manifest} and {engine-cargo-lock}. Fixtures build or declare every executable they use and own their resources."

[evals.publish]
title = "The CLI packages and builds as its release publishes it"
profile = { kind = "runtime", command = "node", args = ["publish.mjs"], timeout_ms = 1800000 }

[evals.publish.payload]
instruction = "Package and verify {engine-cli} with the workspace {engine-cargo-manifest} and {engine-cargo-lock} exactly as its release would publish it, without uploading. The CLI's release publishes the library crates it depends on, {engine-core}, {engine-tools} and {engine-mcp}, in the same publication, so they are packaged with it. Allow the builder's uncommitted candidate; the package verification still builds every crate."
