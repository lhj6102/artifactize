// The workspace's crates, each with the checks every crate carries (rust-crate.artf).

artf engine-core = rust-crate!(
  package = "artifactize-core",
  subject = "The core library code",
  example = "src/cache.rs",
  extra_evals = {
    eval follows-chat-acp : luna = {
      title = "The core library upholds the Chat ACP principles and invariants"
      red_at = "P1"
      instruction = """
        Read the invariants @{artf rules-chat-acp}. Then review the Chat, ACP, store, config \
        and eval routing code of @{artf self} (src/) against every C- item. Tool paths are \
        relative to the Artifact, for example src/chat.rs. Report only what a rule item states: \
        each issue names the item it violates and points to a concrete place where that item's \
        text is not met. An improvement the item's text does not require is not an issue.
      """
    }
  },
)

artf engine-tools = rust-crate!(
  package = "artifactize-tools",
  subject = "The tools code",
  example = "src/scope.rs",
)

artf engine-mcp = rust-crate!(
  package = "artifactize-mcp",
  subject = "The MCP server code",
  example = "src/lib.rs",
)

artf engine-cli = rust-crate!(
  package = "artifactize",
  subject = "The CLI code",
  example = "src/main.rs",
  builds_with = [engine-core, engine-tools, engine-mcp],
  extra_evals = {
    eval publish : runtime(command = "node", args = ["publish.mjs"], timeout_ms = 1800000) = {
      title = "The CLI packages and builds as its release publishes it"
      instruction = "Package and verify the CLI with the workspace manifest and lockfile exactly as its release would publish it, without uploading. Its release publishes the library crates it depends on (core, tools and MCP) in the same publication, so they are packaged with it. Allow the builder's uncommitted candidate; the package verification still builds every crate."
      inputs = [engine-core, engine-tools, engine-mcp, engine-cargo-manifest, engine-cargo-lock]
    }
  },
)

// The workspace manifest and lockfile are inputs of every Cargo build and need no review of
// their own.
artf engine-cargo-manifest = { path = "Cargo.toml", basis = true }
artf engine-cargo-lock = { path = "Cargo.lock", basis = true }
