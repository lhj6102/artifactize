path = "crates/artifactize-core/"
type = "files"

[evals.follows-style]
title = "The core library code follows the code checklist"
profile = { kind = "agent", backend = "codex", model = "gpt-6.2-sol", reasoning = "xhigh", timeout_ms = 1800000 }
red_at = "P1"

[evals.follows-style.profile_variants]
sol-medium = { kind = "agent", backend = "codex", model = "gpt-6.2-sol", reasoning = "medium", timeout_ms = 1800000 }
sol-max = { kind = "agent", backend = "codex", model = "gpt-6.2-sol", reasoning = "max", timeout_ms = 1800000 }
luna-max = { kind = "agent", backend = "codex", model = "gpt-6-luna", reasoning = "max", timeout_ms = 1800000 }

[evals.follows-style.payload]
instruction = """
Read the checklist {rules-code-style}. Then review the Rust code of {engine-core} (src/ \
and Cargo.toml; tests/ for M-TAUTOLOGICAL-TESTS and every TEST- rule) against every item. Tool paths are relative to the Artifact, for example src/cache.rs. Report only what a rule item states: each finding names the item (or journey) it violates and points to a concrete place where that item's text is not met. An improvement the item's text does not require (a further split, a stronger type, an extra assertion, a scenario on an OS the item does not name) is not a finding."""

[evals.follows-platform]
title = "The core library code follows the platform checklist"
profile = { kind = "agent", backend = "codex", model = "gpt-6.2-sol", reasoning = "xhigh", timeout_ms = 1800000 }
red_at = "P1"

[evals.follows-platform.profile_variants]
sol-medium = { kind = "agent", backend = "codex", model = "gpt-6.2-sol", reasoning = "medium", timeout_ms = 1800000 }
sol-max = { kind = "agent", backend = "codex", model = "gpt-6.2-sol", reasoning = "max", timeout_ms = 1800000 }
luna-max = { kind = "agent", backend = "codex", model = "gpt-6-luna", reasoning = "max", timeout_ms = 1800000 }

[evals.follows-platform.payload]
instruction = """
Read the checklist {rules-platform}. Then review the Rust code of {engine-core} (src/, \
tests/ and Cargo.toml) against every P- item. Tool paths are relative to the Artifact, for example src/cache.rs. Report only what a rule item states: each finding names the item (or journey) it violates and points to a concrete place where that item's text is not met. An improvement the item's text does not require (a further split, a stronger type, an extra assertion, a scenario on an OS the item does not name) is not a finding."""

[evals.fmt]
title = "The Rust formatting check passes"
profile = { kind = "runtime", command = "cargo", args = ["fmt", "--check", "-p", "artifactize-core"], timeout_ms = 60000 }

[evals.fmt.payload]
instruction = "Check the formatting of {engine-core}."

[evals.clippy]
title = "Clippy passes for every Rust target"
profile = { kind = "runtime", command = "cargo", args = ["clippy", "--locked", "-p", "artifactize-core", "--all-targets", "--", "-D", "warnings"], timeout_ms = 1800000 }

[evals.clippy.payload]
instruction = "Check every Rust target of {engine-core} with {engine-tools} with the workspace {engine-cargo-manifest} and {engine-cargo-lock}, treating every clippy warning as an error."

[evals.tests]
title = "The Rust crate tests pass"
profile = { kind = "runtime", command = "cargo", args = ["test", "--locked", "-p", "artifactize-core"], timeout_ms = 1800000 }

[evals.tests.payload]
instruction = "Run the tests of {engine-core} with {engine-tools} with the workspace {engine-cargo-manifest} and {engine-cargo-lock}. Fixtures build or declare every executable they use and own their resources."
