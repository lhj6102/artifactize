artf docs-readme : markdown = {
  path = "README.md"

  eval follows-rules : reviewer = {
    title = "The README introduces the project in the owner's flow"
    red_at = "P1"
    instruction = """
      Read the README rules @{artf rules-writer-readme}, the shared introduction checklist @{artf rules-writer-introduction} and the
      root README @{artf docs-readme}. Check every R- and W- item.
    """
  }

  eval matches-landing-install : reviewer = {
    title = "The README's installation matches the landing page's install section"
    red_at = "P1"
    instruction = """
      Read the installation section of the root README @{artf docs-readme} and the install section of index.html
      of @{artf docs-landing}. For each operating system (Linux, macOS, Windows), compare what the two tell a
      reader to do: the default install command must be identical, an alternative method both name
      must be the same, and both must agree on which channels are not available yet. Wording and
      layout may differ, and either may mention a detail the other leaves out as long as nothing
      contradicts.
      Each mismatch is an issue, to be fixed in the README.
    """
  }
}
