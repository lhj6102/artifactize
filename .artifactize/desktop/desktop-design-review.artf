path = "crates/artifactize-desktop/design/review.html"
# Review: a Human review in the Main area

[views.agent_tools]
read = { builtin = "read", args = ["review.html"] }

[evals.well-formed]
title = "The review page has the form every screen page shares"
profile = { kind = "runtime", command = "node", args = ["{desktop-design-check}", "page", "review.html"], timeout_ms = 30000 }

[evals.well-formed.payload]
instruction = """
Check {desktop-design-review} against the page form of {desktop-design-check}, which every screen page shares."""
