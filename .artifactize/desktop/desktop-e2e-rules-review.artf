# A review of the E2E rules against their purpose. Nothing depends on it, so its verdict is
# advice for the owner and never blocks the evals that read the rules.
path = "crates/artifactize-desktop/rules/E2E.md"

[evals.serves-purpose]
title = "Every E2E rule serves the rules' purpose, and none overlap or contradict"
profile = { kind = "agent", backend = "codex", model = "gpt-6.2-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.serves-purpose.payload]
instruction = """
Read the end-to-end rules E2E.md of {desktop-e2e-rules}. Their purpose: when the E2E suite passes locally, it should \
very likely pass on the other platforms too; to that end, everything that differs between platforms is handled in one \
place. Read the suite's platform layer, platform.ts of {desktop-e2e}, only as context for how platforms differ in \
practice; do not review the suite's code. Review the rules themselves, rule by rule (E2E- items), and report: a rule \
that does not serve the purpose (for example a style preference with no cross-platform or reliability effect); two \
rules that overlap or contradict each other; a known way the platforms (Linux WebKitGTK, macOS WKWebView, Windows \
WebView2, their OS process, file, window and input behaviour) differ that no rule governs. Report only what a rule \
item states or omits against this purpose: each finding names the item (or the pair of items, or the missing \
difference) and points to the concrete text that does not meet the purpose. A rewording, a further split or an \
extra example the purpose does not require is not a finding. Submit GREEN when every rule serves the purpose and \
none conflict. Otherwise submit RED with up to 20 findings, most important first, each with the rule id or ids \
(item), the rule text or the platform difference (where) and one sentence on what to change."""

[evals.serves-purpose.pass_schema]
type = "object"
properties = { summary = { type = "string", minLength = 1 } }
required = ["summary"]
additionalProperties = false

[evals.serves-purpose.fail_schema]
type = "object"
properties = { findings = { type = "array", minItems = 1, maxItems = 20, items = { type = "object", properties = { item = { type = "string", minLength = 1 }, where = { type = "string", minLength = 1 }, change = { type = "string", minLength = 1 } }, required = ["item", "where", "change"], additionalProperties = false } } }
required = ["findings"]
additionalProperties = false
