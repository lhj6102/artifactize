path = "crates/artifactize-desktop/ui/e2e/"
select = ["portable.ts", "domain-fixtures", "environment.ts", "fixture.ts", "build-fixtures.ts", "browser-fixtures.ts", "catalog-fixtures.ts", "declaration-fixtures.ts", "native-fixtures.ts", "process-fixtures.ts", "rich-fixture.ts", "run-fixtures.ts", "runs.ts"]
# The E2E suite's fixtures: repositories, state, stand-in programs and servers, and their release; a part of desktop-e2e.

[views.agent_tools]
list = { builtin = "list" }
glob = { builtin = "glob" }
grep = { builtin = "grep" }
read = { builtin = "read" }

[evals.follows-rules]
title = "The fixtures belong to one app instance and are isolated"
profile = { kind = "agent", backend = "codex", model = "gpt-6.2-sol", reasoning = "medium", timeout_ms = 1800000 }

[evals.follows-rules.payload]
instruction = """
Read E2E-OWNED-FIXTURES and E2E-ISOLATED of the end-to-end rules {desktop-e2e-rules}. Review the fixture code \
of {desktop-e2e-fixtures} against them: each fixture belongs to one app instance, is released only once that \
app and what it launched are confirmed ended, keeps its files when an end is unconfirmed, and gives each \
scenario its own repository, state and environment. Report only a violation you are confident causes a real \
failure: a scenario that would break on another OS, a flaky or order-dependent result, a leaked process or \
file, an outcome the case does not actually observe, or a direct contradiction of a rule's text. Hypothetical \
edge cases, style preferences and 'could be more robust' are not findings. At most 5 findings, most severe \
first. If unsure, submit GREEN. Otherwise submit RED, each finding with the rule id (item), a path:line \
(where) and one sentence on what to change."""

[evals.follows-rules.pass_schema]
type = "object"
properties = { summary = { type = "string", minLength = 1 } }
required = ["summary"]
additionalProperties = false

[evals.follows-rules.fail_schema]
type = "object"
properties = { violations = { type = "array", minItems = 1, maxItems = 5, items = { type = "object", properties = { item = { type = "string", minLength = 1 }, where = { type = "string", minLength = 1 }, change = { type = "string", minLength = 1 } }, required = ["item", "where", "change"], additionalProperties = false } } }
required = ["violations"]
additionalProperties = false
