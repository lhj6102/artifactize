path = "crates/artifactize-desktop/ui/e2e/"
select = ["portable.ts", "domain-fixtures", "environment.ts", "fixture.ts", "build-fixtures.ts", "catalog-fixtures.ts", "declaration-fixtures.ts", "native-fixtures.ts", "process-fixtures.ts", "rich-fixture.ts", "run-fixtures.ts", "runs.ts"]
# The E2E suite's fixtures: repositories, state, stand-in programs and servers, and their release; a part of desktop-e2e.

[views.agent_tools]
list = { builtin = "list" }
glob = { builtin = "glob" }
grep = { builtin = "grep" }
read = { builtin = "read" }

[evals.follows-rules]
title = "The fixtures belong to one app instance and are isolated"
profile = { kind = "agent", backend = "codex", model = "gpt-6.2-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.follows-rules.payload]
instruction = """
Read E2E-OWNED-FIXTURES and E2E-ISOLATED of the end-to-end rules {desktop-e2e-rules}. Review the fixture code \
of {desktop-e2e-fixtures} against them: each fixture belongs to one app instance, is released only once that \
app and what it launched are confirmed ended, keeps its files when an end is unconfirmed, and gives each \
scenario its own repository, state and environment. Report only what a rule item states: each finding names \
the item it violates and points to a concrete place where that item's text is not met, with a plausible action \
or interleaving where it is about timing or ownership. An improvement the item's text does not require (a \
further split, a stronger type, an extra assertion, a scenario on an OS the item does not name) is not a \
finding, nor is code outside this Artifact. Submit GREEN when none of these rules is clearly violated. \
Otherwise submit RED with up to 20 violations, most important first, each with the rule id (item), a path:line \
(where) and one sentence on what to change."""

[evals.follows-rules.pass_schema]
type = "object"
properties = { summary = { type = "string", minLength = 1 } }
required = ["summary"]
additionalProperties = false

[evals.follows-rules.fail_schema]
type = "object"
properties = { violations = { type = "array", minItems = 1, maxItems = 20, items = { type = "object", properties = { item = { type = "string", minLength = 1 }, where = { type = "string", minLength = 1 }, change = { type = "string", minLength = 1 } }, required = ["item", "where", "change"], additionalProperties = false } } }
required = ["violations"]
additionalProperties = false
