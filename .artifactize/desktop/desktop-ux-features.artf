path = "crates/artifactize-desktop/rules/ux/"
type = "markdown"

[views.agent_tools]
list = { builtin = "list" }
glob = { builtin = "glob" }
grep = { builtin = "grep" }

[views.human_tools]
open = { description = "Open the journeys folder of {artifactName} in the desktop's default application.", builtin = "open", args = ["{artifactPath}"] }

[evals.approved]
title = "The owner approves the journeys as what the desktop app does"
profile = { kind = "human" }

[evals.approved.payload]
instruction = """
Open {desktop-ux-features} with the view or open tool and read index.md, chat.md, verify.md and review.md. \
Submit GREEN with approved: true when every journey is one the desktop app should offer and none is missing; \
otherwise submit RED and list the changes."""

[evals.approved.pass_schema]
type = "object"
properties.approved = { const = true }
properties.comment = { type = "string" }
required = ["approved"]
additionalProperties = false

[evals.approved.fail_schema]
type = "object"
properties.change = { type = "array", items = { type = "string", minLength = 1 }, minItems = 1 }
required = ["change"]
additionalProperties = false
