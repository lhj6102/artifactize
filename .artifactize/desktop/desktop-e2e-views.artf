path = "crates/artifactize-desktop/ui/e2e/"
select = ["graph-view.ts", "human-review.ts", "palette-commands.ts", "pane.ts", "rendering.ts", "tool-log.ts"]
# The E2E suite's window readers: what the cases read from the window and how they wait for it; a part of desktop-e2e.

[views.agent_tools]
list = { builtin = "list" }
glob = { builtin = "glob" }
grep = { builtin = "grep" }
read = { builtin = "read" }

[evals.follows-rules]
title = "The window readers read what the window shows and wait for it causally"
profile = { kind = "agent", backend = "codex", model = "gpt-6.2-sol", reasoning = "medium", timeout_ms = 1800000 }

[evals.follows-rules.payload]
instruction = """
Read E2E-REAL-APP and E2E-CAUSAL-OUTCOMES of the end-to-end rules {desktop-e2e-rules} and the TEST- rules of \
{rules-code-style}. Review the window readers of {desktop-e2e-views} against them: they read what the window \
shows a person (not renderer internals), change no product state, and wait for what the window shows as the \
result of an action. Report only a violation you are confident causes a real failure: a scenario that would \
break on another OS, a flaky or order-dependent result, a leaked process or file, an outcome the case does not \
actually observe, or a direct contradiction of a rule's text. Hypothetical edge cases, style preferences and \
'could be more robust' are not findings. At most 5 findings, most severe first. If unsure, submit GREEN. \
Otherwise submit RED, each finding with the rule id (item), a path:line (where) and one sentence on what to \
change."""

[evals.follows-rules.pass_schema]
type = "object"
properties = { summary = { type = "string", minLength = 1 } }
required = ["summary"]
additionalProperties = false

[evals.follows-rules.fail_schema]
type = "object"
properties = { violations = { type = "array", minItems = 1, maxItems = 5, items = { type = "object", properties = { item = { type = "string", minLength = 1 }, where = { type = "string", minLength = 1 }, change = { type = "string", minLength = 1 } }, required = ["item", "where", "change"], additionalProperties = false } } }
required = ["violations"]
additionalProperties = false
