path = "crates/artifactize-desktop/ui/e2e/"
select = ["platform.ts"]
# The E2E suite's platform layer: everything that differs between operating systems; a part of desktop-e2e.

[views.agent_tools]
list = { builtin = "list" }
glob = { builtin = "glob" }
grep = { builtin = "grep" }
read = { builtin = "read" }

[evals.follows-platform]
title = "The platform layer holds the suite's OS differences, portably and alone"
profile = { kind = "agent", backend = "codex", model = "gpt-6.2-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.follows-platform.payload]
instruction = """
Read E2E-PLATFORM of the end-to-end rules {desktop-e2e-rules} and the platform checklist {rules-platform}. \
Review platform.ts of {desktop-e2e-platform} against them: it handles what differs between operating systems, \
offers portable functions for it, and holds OS differences only. Report only what a rule item states: each \
finding names the item it violates and points to a concrete place where that item's text is not met, with a \
plausible action or interleaving where it is about timing or ownership. An improvement the item's text does \
not require (a further split, a stronger type, an extra assertion, a scenario on an OS the item does not name) \
is not a finding, nor is code outside this Artifact. Submit GREEN when none of these rules is clearly \
violated. Otherwise submit RED with up to 20 violations, most important first, each with the rule id (item), a \
path:line (where) and one sentence on what to change."""

[evals.follows-platform.pass_schema]
type = "object"
properties = { summary = { type = "string", minLength = 1 } }
required = ["summary"]
additionalProperties = false

[evals.follows-platform.fail_schema]
type = "object"
properties = { violations = { type = "array", minItems = 1, maxItems = 20, items = { type = "object", properties = { item = { type = "string", minLength = 1 }, where = { type = "string", minLength = 1 }, change = { type = "string", minLength = 1 } }, required = ["item", "where", "change"], additionalProperties = false } } }
required = ["violations"]
additionalProperties = false
