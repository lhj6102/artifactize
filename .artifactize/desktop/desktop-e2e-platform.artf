path = "crates/artifactize-desktop/ui/e2e/"
select = ["platform.ts"]
# The E2E suite's platform layer: everything that differs between operating systems; a part of desktop-e2e.

[views.agent_tools]
list = { builtin = "list" }
glob = { builtin = "glob" }
grep = { builtin = "grep" }
read = { builtin = "read" }

[evals.follows-platform]
title = "The platform layer holds the suite's OS differences, portably and alone"
profile = { kind = "agent", backend = "codex", model = "gpt-6.2-sol", reasoning = "medium", timeout_ms = 1800000 }

[evals.follows-platform.payload]
instruction = """
Read E2E-PLATFORM of the end-to-end rules {desktop-e2e-rules} and the platform checklist {rules-platform}. \
Review platform.ts of {desktop-e2e-platform} against them: it handles what differs between operating systems, \
offers portable functions for it, and holds OS differences only. Report only a violation you are confident \
causes a real failure: a scenario that would break on another OS, a flaky or order-dependent result, a leaked \
process or file, an outcome the case does not actually observe, or a direct contradiction of a rule's text. \
Hypothetical edge cases, style preferences and 'could be more robust' are not findings. At most 5 findings, \
most severe first. If unsure, submit GREEN. Otherwise submit RED, each finding with the rule id (item), a \
path:line (where) and one sentence on what to change."""

[evals.follows-platform.pass_schema]
type = "object"
properties = { summary = { type = "string", minLength = 1 } }
required = ["summary"]
additionalProperties = false

[evals.follows-platform.fail_schema]
type = "object"
properties = { violations = { type = "array", minItems = 1, maxItems = 5, items = { type = "object", properties = { item = { type = "string", minLength = 1 }, where = { type = "string", minLength = 1 }, change = { type = "string", minLength = 1 } }, required = ["item", "where", "change"], additionalProperties = false } } }
required = ["violations"]
additionalProperties = false
