// The E2E suite's views (what the cases read from the window and how each action waits for its
// visible result) and its cases, the journey flows; a part of desktop-e2e.
artf desktop-e2e-cases : files = {
  path = "crates/artifactize-desktop/ui/e2e/"
  select = ["views", "cases"]

  eval follows-rules : reviewer = {
    title = "The views and cases drive the real app and wait for what the window shows"
    red_at = "P1"
    instruction = "Read E2E-REAL-APP of the end-to-end rules @{artf desktop-e2e-rules} and the TEST- rules and M-TAUTOLOGICAL-TESTS of @{artf rules-code-style}. Review the views and cases of @{artf desktop-e2e-cases} against them: each case drives the app through its UI, each action waits for what the window shows as its result, and each check can fail. Follow imports into @{artf desktop-e2e-infra} as needed without reviewing that Artifact; coverage of the journeys is reviewed by desktop-e2e. Report only a defect you can show: name the OS, the order or the timing under which it happens and the concrete failure or false pass it causes, such as a wait that passes before the action's result shows, a check that cannot fail, or a scenario that breaks on one OS. Hardening, theoretical edge cases, further assertions and style are not issues."
  }
}
