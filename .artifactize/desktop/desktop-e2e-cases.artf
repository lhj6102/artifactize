path = "crates/artifactize-desktop/ui/e2e/"
select = ["cases", "graph-view.ts", "human-review.ts", "palette-commands.ts", "pane.ts", "rendering.ts", "tool-log.ts"]
# The E2E suite's views (what the cases read from the window and how each action waits for its
# visible result) and its cases, the journey flows; a part of desktop-e2e.

[views.agent_tools]
list = { builtin = "list" }
glob = { builtin = "glob" }
grep = { builtin = "grep" }
read = { builtin = "read" }

[evals.follows-rules]
title = "The views and cases drive the real app and wait for what the window shows"
profile = { kind = "agent", backend = "codex", model = "gpt-6.2-sol", reasoning = "medium", timeout_ms = 1800000 }

[evals.follows-rules.payload]
instruction = """
Read E2E-REAL-APP of the end-to-end rules {desktop-e2e-rules} and the TEST- rules and M-TAUTOLOGICAL-TESTS of \
{rules-code-style}. Review the views and cases of {desktop-e2e-cases} against them: each case drives the app through \
its UI, each action waits for what the window shows as its result, and each check can fail. Take the helpers outside \
this Artifact at what their names and comments say; coverage of the journeys is reviewed by desktop-e2e. Report only \
a defect you can show: name the OS, the order or the timing under which it happens and the concrete failure or false \
pass it causes, such as a wait that passes before the action's result shows, a check that cannot fail, or a scenario \
that breaks on one OS. Hardening, theoretical edge cases, further assertions and style are not findings. At most 3 \
findings, most severe first. If unsure, submit GREEN. Otherwise submit RED, each finding with the rule id (item), a \
path:line (where) and one sentence on the failure and what to change (change)."""

[evals.follows-rules.pass_schema]
type = "object"
properties = { summary = { type = "string", minLength = 1 } }
required = ["summary"]
additionalProperties = false

[evals.follows-rules.fail_schema]
type = "object"
properties = { violations = { type = "array", minItems = 1, maxItems = 3, items = { type = "object", properties = { item = { type = "string", minLength = 1 }, where = { type = "string", minLength = 1 }, change = { type = "string", minLength = 1 } }, required = ["item", "where", "change"], additionalProperties = false } } }
required = ["violations"]
additionalProperties = false
