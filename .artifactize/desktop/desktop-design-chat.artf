path = "crates/artifactize-desktop/design/chat.html"
# Chat: a session with Artifactize's own agent

[views.agent_tools]
read = { builtin = "read", args = ["chat.html"] }

[evals.well-formed]
title = "The chat page has the form every screen page shares"
profile = { kind = "runtime", command = "node", args = ["{desktop-design-check}", "page", "chat.html"], timeout_ms = 30000 }

[evals.well-formed.payload]
instruction = """
Check {desktop-design-chat} against the page form of {desktop-design-check}, which every screen page shares."""
