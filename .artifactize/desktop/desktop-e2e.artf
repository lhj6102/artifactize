path = "crates/artifactize-desktop/ui/e2e/"
parts = ["desktop-e2e-input", "desktop-e2e-integrity", "desktop-e2e-infra", "desktop-e2e-cases"]

[views.agent_tools]
list = { builtin = "list" }
glob = { builtin = "glob" }
grep = { builtin = "grep" }
read = { builtin = "read" }

[evals.covers-journeys]
title = "The scenarios cover every journey of the UX"
profile = { kind = "agent", backend = "codex", model = "gpt-6.2-sol", reasoning = "medium", timeout_ms = 1800000 }

[evals.covers-journeys.payload]
instruction = """
Read the journeys {desktop-ux-features} and E2E-COVERAGE of the end-to-end rules {desktop-e2e-rules}. Review the \
scenarios of {desktop-e2e} (cases/, read through the views they call) for coverage only, as E2E-COVERAGE defines \
it. A gap is a journey no scenario covers, or one whose check would still pass with the journey's key outcome \
broken: say which breakage would pass unnoticed. What E2E-COVERAGE makes optional is not a gap, and code style and \
the other rules have their own reviews. At most 3 gaps, the most important first. If unsure, submit GREEN. Otherwise \
submit RED, each gap with the journey id (item), a test path:line (where) and one sentence on the breakage that \
passes and what to add (change)."""

[evals.covers-journeys.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.covers-journeys.fail_schema]
type = "object"
required = ["gaps"]
additionalProperties = false

[evals.covers-journeys.fail_schema.properties.gaps]
type = "array"
minItems = 1
maxItems = 3

[evals.covers-journeys.fail_schema.properties.gaps.items]
type = "object"
properties.item = { type = "string", minLength = 1 }
properties.where = { type = "string", minLength = 1 }
properties.change = { type = "string", minLength = 1 }
required = ["item", "where", "change"]
additionalProperties = false

[evals.lint]
title = "The end-to-end TypeScript lint and type check pass"
profile = { kind = "runtime", command = "pnpm", args = ["lint"], timeout_ms = 600000 }

[evals.lint.payload]
instruction = "Check the source-integrity rules over the suite {desktop-e2e} and its vendored provider with its part {desktop-e2e-integrity} (the checker it runs); then run TypeScript eslint over every test and helper of {desktop-e2e}, which enforces the mechanical parts of E2E-PLATFORM and E2E-REAL-APP of {desktop-e2e-rules}, then type-check them."

