path = "crates/artifactize-desktop/design/overlays.html"
# Overlays: the palette, Help, dialogs and the find field

[views.agent_tools]
read = { builtin = "read", args = ["overlays.html"] }

[evals.well-formed]
title = "The overlays page has the form every screen page shares"
profile = { kind = "runtime", command = "node", args = ["{desktop-design-check}", "page", "overlays.html"], timeout_ms = 30000 }

[evals.well-formed.payload]
instruction = """
Check {desktop-design-overlays} against the page form of {desktop-design-check}, which every screen page shares."""
