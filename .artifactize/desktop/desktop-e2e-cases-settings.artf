path = "crates/artifactize-desktop/ui/e2e/cases/"
select = ["settings.ts", "accounts.ts", "release.ts"]
# The E2E cases of Settings, accounts and the release notice; a part of desktop-e2e.

[views.agent_tools]
list = { builtin = "list" }
glob = { builtin = "glob" }
grep = { builtin = "grep" }
read = { builtin = "read" }

[evals.follows-rules]
title = "The settings cases drive the real app causally and cover their journeys"
profile = { kind = "agent", backend = "codex", model = "gpt-6.2-sol", reasoning = "medium", timeout_ms = 1800000 }

[evals.follows-rules.payload]
instruction = """
Read E2E-REAL-APP, E2E-CAUSAL-OUTCOMES and E2E-COVERAGE of the end-to-end rules {desktop-e2e-rules}, the \
journeys {desktop-ux-features} and the TEST- rules and M-TAUTOLOGICAL-TESTS of {rules-code-style}. Review the \
case files of {desktop-e2e-cases-settings} against them: each case drives the app through its UI, waits for \
what the window shows as the result of its own action, checks its journey's key visible outcome as \
E2E-COVERAGE defines it, and follows the test-writing rules. Judge the cases as written, taking the suite's \
helpers and fixtures at what their names and comments say; those are reviewed in their own Artifacts. Report \
only a violation you are confident causes a real failure: a scenario that would break on another OS, a flaky \
or order-dependent result, a leaked process or file, an outcome the case does not actually observe, or a \
direct contradiction of a rule's text. Hypothetical edge cases, style preferences and 'could be more robust' \
are not findings. At most 5 findings, most severe first. If unsure, submit GREEN. Otherwise submit RED, each \
finding with the rule id (item), a path:line (where) and one sentence on what to change."""

[evals.follows-rules.pass_schema]
type = "object"
properties = { summary = { type = "string", minLength = 1 } }
required = ["summary"]
additionalProperties = false

[evals.follows-rules.fail_schema]
type = "object"
properties = { violations = { type = "array", minItems = 1, maxItems = 5, items = { type = "object", properties = { item = { type = "string", minLength = 1 }, where = { type = "string", minLength = 1 }, change = { type = "string", minLength = 1 } }, required = ["item", "where", "change"], additionalProperties = false } } }
required = ["violations"]
additionalProperties = false
