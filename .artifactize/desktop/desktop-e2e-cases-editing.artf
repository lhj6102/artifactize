path = "crates/artifactize-desktop/ui/e2e/cases/"
select = ["editing.ts", "current-graph.ts", "detail-content.ts"]
# The E2E cases of the Current, editing definitions on the graph and the Detail's content; a part of desktop-e2e.

[views.agent_tools]
list = { builtin = "list" }
glob = { builtin = "glob" }
grep = { builtin = "grep" }
read = { builtin = "read" }

[evals.follows-rules]
title = "The editing cases drive the real app causally and cover their journeys"
profile = { kind = "agent", backend = "codex", model = "gpt-6.2-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.follows-rules.payload]
instruction = """
Read E2E-REAL-APP, E2E-CAUSAL-OUTCOMES and E2E-COVERAGE of the end-to-end rules {desktop-e2e-rules}, the \
journeys {desktop-ux-features} and the TEST- rules and M-TAUTOLOGICAL-TESTS of {rules-code-style}. Review the \
case files of {desktop-e2e-cases-editing} against them: each case drives the app through its UI, waits for \
what the window shows as the result of its own action, checks its journey's key visible outcome as \
E2E-COVERAGE defines it, and follows the test-writing rules. Judge the cases as written, taking the suite's \
helpers and fixtures at what their names and comments say; those are reviewed in their own Artifacts. Report \
only what a rule item states: each finding names the item it violates and points to a concrete place where \
that item's text is not met, with a plausible action or interleaving where it is about timing or ownership. An \
improvement the item's text does not require (a further split, a stronger type, an extra assertion, a scenario \
on an OS the item does not name) is not a finding, nor is code outside this Artifact. Submit GREEN when none \
of these rules is clearly violated. Otherwise submit RED with up to 20 violations, most important first, each \
with the rule id (item), a path:line (where) and one sentence on what to change."""

[evals.follows-rules.pass_schema]
type = "object"
properties = { summary = { type = "string", minLength = 1 } }
required = ["summary"]
additionalProperties = false

[evals.follows-rules.fail_schema]
type = "object"
properties = { violations = { type = "array", minItems = 1, maxItems = 20, items = { type = "object", properties = { item = { type = "string", minLength = 1 }, where = { type = "string", minLength = 1 }, change = { type = "string", minLength = 1 } }, required = ["item", "where", "change"], additionalProperties = false } } }
required = ["violations"]
additionalProperties = false
