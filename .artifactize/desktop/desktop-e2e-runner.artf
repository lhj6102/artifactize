path = "crates/artifactize-desktop/ui/e2e/"
select = ["wdio.conf.ts", "run.ts", "build.ts", "observation.ts", "observation.test.ts", "graph-tool-session.ts", "scenario.ts", "catalog.ts", "journey.spec.ts", "input.ts", "input.test.ts", "keys.ts", "keys.test.ts", "commands.ts", "commands.test.ts", "pointer.ts", "runner.test.ts", "check-integrity.ts", "package.json", "tsconfig.json", "provider-upstream.json"]
# The E2E suite's runner: WebdriverIO configuration, the batch runner, the build, app observation and the input helpers; a part of desktop-e2e.

[views.agent_tools]
list = { builtin = "list" }
glob = { builtin = "glob" }
grep = { builtin = "grep" }
read = { builtin = "read" }

[evals.follows-rules]
title = "The runner leaves the app to the WebdriverIO service, reaches it by allowed input and fails explicitly"
profile = { kind = "agent", backend = "codex", model = "gpt-6.2-sol", reasoning = "medium", timeout_ms = 1800000 }

[evals.follows-rules.payload]
instruction = """
Read E2E-WDIO-SERVICE, E2E-INPUT and E2E-EXPLICIT-FAILURE of the end-to-end rules {desktop-e2e-rules}. Review \
the runner code of {desktop-e2e-runner} against them: the service alone starts and stops the app, a window the \
product launches is observed, closed and confirmed ended as that rule says, input reaches the app only as \
E2E-INPUT allows, and every missing prerequisite or failed setup, cleanup or run is a failure. Report only a \
violation you are confident causes a real failure: a scenario that would break on another OS, a flaky or \
order-dependent result, a leaked process or file, an outcome the case does not actually observe, or a direct \
contradiction of a rule's text. Hypothetical edge cases, style preferences and 'could be more robust' are not \
findings. At most 5 findings, most severe first. If unsure, submit GREEN. Otherwise submit RED, each finding \
with the rule id (item), a path:line (where) and one sentence on what to change."""

[evals.follows-rules.pass_schema]
type = "object"
properties = { summary = { type = "string", minLength = 1 } }
required = ["summary"]
additionalProperties = false

[evals.follows-rules.fail_schema]
type = "object"
properties = { violations = { type = "array", minItems = 1, maxItems = 5, items = { type = "object", properties = { item = { type = "string", minLength = 1 }, where = { type = "string", minLength = 1 }, change = { type = "string", minLength = 1 } }, required = ["item", "where", "change"], additionalProperties = false } } }
required = ["violations"]
additionalProperties = false
