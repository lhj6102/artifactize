path = "crates/artifactize-desktop/design/viewers.html"
# Viewers: Artifact Viewer windows and the pet overlay

[views.agent_tools]
read = { builtin = "read", args = ["viewers.html"] }

[evals.well-formed]
title = "The viewers page has the form every screen page shares"
profile = { kind = "runtime", command = "node", args = ["{desktop-design-check}", "page", "viewers.html"], timeout_ms = 30000 }

[evals.well-formed.payload]
instruction = """
Check {desktop-design-viewers} against the page form of {desktop-design-check}, which every screen page shares."""
