path = "crates/artifactize-desktop/design/settings.html"
# Settings: a modal over the screen

[views.agent_tools]
read = { builtin = "read", args = ["settings.html"] }

[evals.well-formed]
title = "The settings page has the form every screen page shares"
profile = { kind = "runtime", command = "node", args = ["{desktop-design-check}", "page", "settings.html"], timeout_ms = 30000 }

[evals.well-formed.payload]
instruction = """
Check {desktop-design-settings} against the page form of {desktop-design-check}, which every screen page shares."""
