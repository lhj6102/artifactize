path = "crates/artifactize-desktop/design/monitor.html"
# Monitor: the one screen with a Run shown

[views.agent_tools]
read = { builtin = "read", args = ["monitor.html"] }

[evals.well-formed]
title = "The monitor page has the form every screen page shares"
profile = { kind = "runtime", command = "node", args = ["{desktop-design-check}", "page", "monitor.html"], timeout_ms = 30000 }

[evals.well-formed.payload]
instruction = """
Check {desktop-design-monitor} against the page form of {desktop-design-check}, which every screen page shares."""
