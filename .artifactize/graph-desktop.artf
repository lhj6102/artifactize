path = ".artifactize/desktop/"

[views.agent_tools]
list = { builtin = "list" }
glob = { builtin = "glob" }
grep = { builtin = "grep" }
read = { builtin = "read" }
graph = { builtin = "graph", args = [] }

[evals.derives]
title = "The desktop definitions judge each Artifact against what specifies it"
profile = { kind = "agent", backend = "codex", model = "gpt-6.2-sol", reasoning = "high", timeout_ms = 1800000 }
payload.instruction = """
Read every definition in {graph-desktop}; use the graph tool for relations that leave the
folder. The desktop app is specified by the journeys (desktop-ux-features), the screens
and edges (desktop-ux-graph) and the design (desktop-design with its pages), and realized
by desktop-ui, desktop-backend, desktop-e2e and desktop. Check that:
- Direction: an eval judges a realization against what specifies it, never a
  specification against its realization. The journeys are judged against nothing in this
  folder, the screens and edges against the journeys, the design against both.
- Coverage: each realization has an eval naming what specifies it: the UI names the
  design; the end-to-end tests name the journeys and the edges; the eval that runs the
  suite names the UI, the backend and the tests it runs.
- Sign-offs: Human evals sit only on specifications.
- Composition: every definition in this folder is desktop or one of its parts, their
  parts included; the design's pages are parts of the design.
- One home: no two evals here state the same criterion about the same Artifact; a check
  lives on the Artifact it judges.
- Shared rules are named, not copied into instructions.

Submit GREEN when nothing clearly violates these. Otherwise submit RED with up to 10
findings, most important first, each with the definition file, the eval or key, and one
sentence on what to change.
"""

[evals.derives.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.derives.fail_schema]
type = "object"
required = ["findings"]
additionalProperties = false

[evals.derives.fail_schema.properties.findings]
type = "array"
minItems = 1
maxItems = 10

[evals.derives.fail_schema.properties.findings.items]
type = "object"
properties.where = { type = "string", minLength = 1 }
properties.change = { type = "string", minLength = 1 }
required = ["where", "change"]
additionalProperties = false
