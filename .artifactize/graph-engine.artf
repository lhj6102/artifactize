// The engine's definitions, judged as a whole: how its crates' checks name their inputs.
artf graph-engine : files & definitions = {
  path = ".artifactize/engine/"

  eval connects : luna = {
    title = "The engine definitions name inputs in one direction and judge each crate's own code"
    red_at = "P1"
    instruction = """
      Read every definition in @{artf self}; use @{tool self agent definitions.graph} for
      relations that leave the folder. The graph's relations run from an input to the Artifact
      whose eval names it: in `a -> b [input eval=b/x name=a]`, eval b/x names a, and a does not
      name b. The folder defines the workspace crates (engine-core, engine-tools, engine-cli,
      engine-mcp), each made by the rust-crate! macro, which gives every crate the same checks,
      and the workspace manifest and lockfile. Check that:
      - Inputs: every eval that builds or tests names the manifest and the lockfile and the
        crates it builds with; taken together these names run one way, so no two crates' evals
        name each other.
      - Own code only: a crate's eval asks for a judgment of that crate, not of another
        crate's code.
      - Checklists are named (rules-code-style, rules-platform), not copied into instructions.
      - Composition: no crate is a part of another.
    """
  }
}
