path = "https://artifactize.dev"

[evals.configuration]
title = "The served installers equal the latest stable origin tag byte for byte"
profile = { kind = "runtime", command = "node", args = ["{release-observer}", "website-config", "{live-website}"], timeout_ms = 30000 }
payload.instruction = "Observe {live-website} read-only using {release-observer}; compare published state with origin, never with this worktree."

[evals.behavior]
title = "The landing pages, docs books and installers answer HTTP 200"
profile = { kind = "runtime", command = "node", args = ["{release-observer}", "website-behavior", "{live-website}"], timeout_ms = 30000 }
payload.instruction = "Observe {live-website} read-only using {release-observer}; compare published state with origin, never with this worktree."
