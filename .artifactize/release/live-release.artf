path = "https://github.com/lhj6102/artifactize/releases/latest"

[evals.configuration]
title = "The latest GitHub release matches the latest stable origin tag"
profile = { kind = "runtime", command = "node", args = ["{release-observer}", "release-config", "{live-release}"], timeout_ms = 30000 }
payload.instruction = "Observe {live-release} read-only using {release-observer}; compare published state with origin, never with this worktree."

[evals.behavior]
title = "The archive and checksum selected by install.sh answer HTTP 200"
profile = { kind = "runtime", command = "node", args = ["{release-observer}", "release-behavior", "{live-release}"], timeout_ms = 30000 }
payload.instruction = "Observe {live-release} read-only using {release-observer}; compare published state with origin, never with this worktree."
