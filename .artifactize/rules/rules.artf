// The project's rule documents under project-rules/. Each is read by the Agent evals that
// check against it, opened by its owner, and approved by the owner before it is the standard.

// An Agent prints the document; a person opens it in the desktop's default application.
tool! rule-doc(file, what) = {
  namespace = "rule"
  agent read = builtin(op = "read", args = ["@{param file}"], description = "Print @{param what} @{param file} of @{artf self}.")
  human open = builtin(op = "open", args = ["@{path self}"], description = "Open @{param file} of @{artf self} in the desktop's default application.")
}

eval! owner-approves(approves, file, when) : human = {
  title = "The owner approves @{param approves}"
  instruction = """
    Open @{param file} of @{artf self} with @{tool self human rule.open}. Submit GREEN when \
    @{param when}; otherwise submit RED with an issue for each item to change.
  """
}

// A rule document FILE: `what` names it in its tools' descriptions, `approves` and `when` say
// what the owner approves.
artf! rule(file, what, approves, when, extra_evals = {}) : rule-doc!(file = file, what = what) = {
  path = "project-rules/@{param file}"
  eval approved = owner-approves!(approves = approves, file = file, when = when)
  ...extra_evals
}

artf rules-code-style = rule!(
  file = "DEV-CODING.md",
  what = "the code checklist",
  approves = "the checklist as the code standard",
  when = "every item is one the codebase should follow",
)

artf rules-frontend-style = rule!(
  file = "DEV-FRONTEND.md",
  what = "the frontend checklist",
  approves = "the checklist as the frontend standard",
  when = "every item is one the desktop UI should follow",
)

artf rules-platform = rule!(
  file = "DEV-PLATFORM.md",
  what = "the platform checklist",
  approves = "the checklist as the platform standard",
  when = "every item is one the codebase should follow",
  extra_evals = {
    eval serves-purpose : luna = {
      title = "Every platform rule serves the checklist's purpose, and none overlap or contradict"
      red_at = "P1"
      instruction = """
        Read the platform checklist DEV-PLATFORM.md of @{artf self}. Its purpose: code that \
        passes its checks on one operating system very likely behaves the same on the others; to \
        that end, everything that differs between operating systems goes through one platform \
        layer, and tests cover every OS. Review the rules themselves, rule by rule (P- items), \
        and report: a rule that does not serve the purpose (for example a style preference with \
        no cross-platform or reliability effect); two rules that overlap or contradict each \
        other; a known way Linux, macOS and Windows differ (files, paths, programs, processes, \
        environment, terminals, IPC, desktop integration, text and time) that no rule governs, \
        but report such a missing rule only when the code shows that difference actually \
        occurring (cite path:line); differences the code never meets are out of scope. Report \
        only what a rule item states or omits against this purpose: each issue names the item \
        (or the pair of items, or the missing difference) and points to the concrete text that \
        does not meet the purpose. A rewording, a further split or an extra example the purpose \
        does not require is not an issue.
      """
    }
  },
)

artf rules-chat-acp = rule!(
  file = "CHAT-ACP.md",
  what = "the Chat ACP invariants",
  approves = "the Chat ACP principles and invariants",
  when = "every C- invariant reflects the Chat ACP architecture that engine-core must uphold",
)

artf rules-write-in-korean = rule!(
  file = "WRITE-IN-KOREAN.md",
  what = "the Korean writing rules",
  approves = "the rules as the Korean writing standard",
  when = "every rule is one the project's Korean writing should follow",
  extra_evals = {
    eval follows-itself : luna = {
      title = "The Korean writing rules follow themselves"
      red_at = "P1"
      instruction = """
        Read WRITE-IN-KOREAN.md of @{artf self} with @{tool self agent rule.read}. It states \
        rules for Korean writing and is itself written in Korean. Read every Korean sentence of \
        it, including the examples, and check it against every K- item of the same document. \
        The item ids, the English words quoted as examples and the phrases quoted in '…' as what \
        not to write are not prose to judge.
      """
    }
  },
)

artf rules-writer-introduction = rule!(
  file = "WRITER-INTRODUCTION.md",
  what = "the writing rules",
  approves = "the rules as the introduction standard",
  when = "every rule is one this project should follow",
)

artf rules-writer-readme = rule!(
  file = "WRITER-README.md",
  what = "the README rules",
  approves = "the rules as the README standard",
  when = "every rule is one this project's README should follow",
)
