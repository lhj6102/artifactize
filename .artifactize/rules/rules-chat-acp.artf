path = "project-rules/CHAT-ACP.md"

[views.agent_tools]

[views.agent_tools.read_chat_acp]
description = "Print the Chat ACP invariants CHAT-ACP.md of {artifactName}."
builtin = "read"
args = ["CHAT-ACP.md"]

[views.human_tools]
open = { description = "Open CHAT-ACP.md of {artifactName} in the desktop's default application.", builtin = "open", args = ["{artifactPath}"] }

[evals.approved]
title = "The owner approves the Chat ACP principles and invariants"
profile = { kind = "human" }

[evals.approved.payload]
instruction = """
Open CHAT-ACP.md of {rules-chat-acp} with the open tool. Submit GREEN with approved: true \
when every C- invariant reflects the Chat ACP architecture that engine-core must uphold; \
otherwise submit RED and list the items to change."""

[evals.approved.pass_schema]
type = "object"
properties.approved = { const = true }
properties.comment = { type = "string" }
required = ["approved"]
additionalProperties = false

[evals.approved.fail_schema]
type = "object"
properties.change = { type = "array", items = { type = "string", minLength = 1 }, minItems = 1 }
required = ["change"]
additionalProperties = false
