name = "brand"

[evals.generated]
title = "Every generated brand asset matches the approved icon and social template"
profile = { kind = "runtime", command = "sh", args = ["check-icons.sh", "{brand-icon}"], timeout_ms = 120000 }

[evals.generated.payload]
instruction = """
After the owner approves {brand-icon}, check that the user's python3 has the required CairoSVG \
and Pillow modules, then rerender every generated asset in {brand} in memory. Pass only when \
every committed output matches the approved artwork and OG template byte-for-byte. Do not \
install tools or modify the generated files during evaluation."""
