name = "readme-kr"

[views.agent_tools.read]
builtin = "read"
args = ["README.kr.md"]

[evals.translates-readme]
title = "The Korean README is an accurate Korean translation of the root README"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.translates-readme.payload]
instruction = """
Read the root README {readme} and its Korean translation {readme-kr}, which lives in
assets/readme/. Check these criteria:
- K-FAITHFUL: Every sentence, list item, heading, caption and image description of the
  root README is translated with the same meaning, in the same order. Nothing is left
  out, added, softened or strengthened.
- K-KOREAN: It reads as natural Korean written for Korean readers, not word-for-word
  English. Product terms the app and its commands show in English (Artifact, Run, Run ID,
  GREEN, screen names such as Monitor, Review and Detail) may stay in English.
- K-SAME-TARGETS: Badges, commands, code blocks and their order are the same; code-block
  comments may be translated. Every link and image reaches the same target as in the root
  README: repository files through paths relative to assets/readme/, and documentation
  pages through the same page under https://artifactize.dev/docs/ko/. The only addition is
  a badge linking back to the English README, matching the root README's badge for this
  translation.
Submit GREEN only when no criterion is clearly violated. Otherwise submit RED with up to
20 violations, most important first, each with the criterion id, the Korean README
path:line, the root README path:line and one sentence on what to change in the Korean README.
"""

[evals.translates-readme.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.translates-readme.fail_schema]
type = "object"
required = ["violations"]
additionalProperties = false

[evals.translates-readme.fail_schema.properties.violations]
type = "array"
minItems = 1
maxItems = 20

[evals.translates-readme.fail_schema.properties.violations.items]
type = "object"
properties.item = { type = "string", minLength = 1 }
properties.translation = { type = "string", minLength = 1 }
properties.original = { type = "string", minLength = 1 }
properties.change = { type = "string", minLength = 1 }
required = ["item", "translation", "original", "change"]
additionalProperties = false
