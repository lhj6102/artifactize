name = "readme-kr"

[views.agent_tools.read]
builtin = "read"
args = ["README.kr.md"]

[evals.translates-readme]
title = "The Korean README is an accurate Korean translation of the root README"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.translates-readme.payload]
instruction = """
Read the root README {readme} and its Korean translation {readme-kr}, which lives in
assets/readme/. Check these criteria:
- K-FAITHFUL: Every sentence, list item, heading, caption and image description of the
  root README is translated with the same meaning, in the same order. Nothing is left
  out, added, softened or strengthened. The headline, the project sentence "Build together
  on an Artifact Graph.", always stays in English.
- K-SAME-TARGETS: Badges, commands, code blocks and their order are the same; code-block
  comments may be translated. Every link and image reaches the same target as in the root
  README: repository files through paths relative to assets/readme/, and documentation
  pages through the same page under https://artifactize.dev/docs/ko/. The only addition is
  a badge linking back to the English README, matching the root README's badge for this
  translation.
Submit GREEN only when no criterion is clearly violated. Otherwise submit RED with up to
20 violations, most important first, each with the criterion id, the Korean README
path:line, the root README path:line and one sentence on what to change in the Korean README.
"""

[evals.translates-readme.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.translates-readme.fail_schema]
type = "object"
required = ["violations"]
additionalProperties = false

[evals.translates-readme.fail_schema.properties.violations]
type = "array"
minItems = 1
maxItems = 20

[evals.translates-readme.fail_schema.properties.violations.items]
type = "object"
properties.item = { type = "string", minLength = 1 }
properties.translation = { type = "string", minLength = 1 }
properties.original = { type = "string", minLength = 1 }
properties.change = { type = "string", minLength = 1 }
required = ["item", "translation", "original", "change"]
additionalProperties = false

[evals.follows-write-in-korean]
title = "The Korean README follows the Korean writing rules"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.follows-write-in-korean.payload]
instruction = """
Read {write-in-korean}. Read the Korean README {readme-kr}, README.kr.md in assets/readme/.
The project sentence "Build together on an Artifact Graph." stays in English by design, as the
headline, and "Artifact Graph" is the product's name for the graph. The root README says
"checks" in plain words where the docs say eval, so the Korean README says 검사 for them.
Check its Korean prose against every K- item. Code, commands, configuration keys, file paths,
output samples and links are not prose and are not judged; whether the Korean says the same as
the English is reviewed elsewhere. Use the read tool of {readme-kr}.
Read every Korean sentence. Submit GREEN only when no sentence violates an item; a sentence
that is grammatical but reads as translated violates K-NATURAL. Otherwise submit RED with up
to 20 violations, most important first, each with the item id, the path:line, the text and
one sentence on how to rewrite it.
"""

[evals.follows-write-in-korean.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.follows-write-in-korean.fail_schema]
type = "object"
required = ["violations"]
additionalProperties = false

[evals.follows-write-in-korean.fail_schema.properties.violations]
type = "array"
minItems = 1
maxItems = 20

[evals.follows-write-in-korean.fail_schema.properties.violations.items]
type = "object"
properties.item = { type = "string", minLength = 1 }
properties.where = { type = "string", minLength = 1 }
properties.text = { type = "string", minLength = 1 }
properties.fix = { type = "string", minLength = 1 }
required = ["item", "where", "text", "fix"]
additionalProperties = false
