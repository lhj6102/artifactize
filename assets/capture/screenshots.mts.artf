name = "media-screenshots-script"
tags = ["type:capture"]

[views.agent_tools]
read = { builtin = "read" }

[evals.records-scenes]
title = "The script captures scenes A, B and C from the real app"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "high" }

[evals.records-scenes.payload]
instruction = """
Read {media-screenshots-script}, the app's feature journeys in {desktop-ux-features} and graph rules in \
{desktop-ux-graph}, and the app in {desktop-backend}, {desktop-ui} and {desktop-e2e} as far as the \
scenes need. Judge whether running the \
script captures each scene below from the real desktop app at 1920×1080, with real data made \
through the real CLI and nothing mocked:

A. The app's one screen (J-PANE, J-BRANCH-RUNS, J-WAITING, J-MAIN-RUN, J-GRAPH-COLOURS): the \
left pane with the example's branch, its Run chips and the waiting sign-off, and the Run's \
graph in the main area, whose Artifacts show mixed verdicts: GREEN, RED, blocked and waiting \
for a person.
B. An Artifact's Detail (J-DETAIL, J-DETAIL-NEIGHBOURS) floating over the graph on its \
Artifact tab: the Artifact between its neighbours, and its evals with their verdicts.
C. A claimed Human review opened from the left pane (J-MAIN-REVIEW, J-HUMAN-LAYOUT, \
J-HUMAN-LOG): its instruction, Tools, a Tool log run and the GREEN form.

Check that each scene's selectors and actions reach the state the journey describes, that the \
script waits for that state rather than a fixed delay alone before capturing, and that it \
cleans up the app, the build and the project it made. Submit GREEN when every scene is \
captured; otherwise RED with one finding per problem.
"""

[evals.records-scenes.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.records-scenes.fail_schema]
type = "object"
properties.findings = { type = "array", minItems = 1, items = { type = "object", properties = { scene = { type = "string", minLength = 1 }, where = { type = "string", minLength = 1 }, change = { type = "string", minLength = 1 } }, required = ["scene", "where", "change"], additionalProperties = false } }
required = ["findings"]
additionalProperties = false
