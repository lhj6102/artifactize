name = "engine::mcp"

[views.agent_tools]
list = { builtin = "list" }
glob = { builtin = "glob" }
grep = { builtin = "grep" }
read = { builtin = "read" }

[evals.follows-style]
title = "The MCP server code follows the code checklist"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.follows-style.profile_variants]
sol-medium = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "medium", timeout_ms = 1800000 }
sol-max = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "max", timeout_ms = 1800000 }
luna-max = { kind = "agent", backend = "codex", model = "gpt-6-luna", reasoning = "max", timeout_ms = 1800000 }

[evals.follows-style.payload]
instruction = """
Read the checklist {rules::code-style} with read_style_rules__code-style. Then review the Rust code of {engine::mcp} (src/ \
and Cargo.toml; tests/ for M-TAUTOLOGICAL-TESTS and every TEST- rule) against every item, using list_engine__mcp, glob_engine__mcp, \
grep_engine__mcp and read_engine__mcp. Tool paths are relative to the Artifact, for example src/lib.rs. Submit \
GREEN when no item is clearly violated. Otherwise submit RED with up to 20 violations, the most \
important first, each with the item id, a path:line and one sentence on what to change."""

[evals.follows-style.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.follows-style.fail_schema]
type = "object"
required = ["violations"]
additionalProperties = false

[evals.follows-style.fail_schema.properties.violations]
type = "array"
minItems = 1
maxItems = 20

[evals.follows-style.fail_schema.properties.violations.items]
type = "object"
properties.item = { type = "string", minLength = 1 }
properties.where = { type = "string", minLength = 1 }
properties.change = { type = "string", minLength = 1 }
required = ["item", "where", "change"]
additionalProperties = false

[evals.follows-platform]
title = "The MCP server code follows the platform checklist"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.follows-platform.profile_variants]
sol-medium = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "medium", timeout_ms = 1800000 }
sol-max = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "max", timeout_ms = 1800000 }
luna-max = { kind = "agent", backend = "codex", model = "gpt-6-luna", reasoning = "max", timeout_ms = 1800000 }

[evals.follows-platform.payload]
instruction = """
Read the checklist {rules::platform} with read_platform_rules__platform. Then review the Rust code of {engine::mcp} (src/, \
tests/ and Cargo.toml) against every P- item, using list_engine__mcp, glob_engine__mcp, \
grep_engine__mcp and read_engine__mcp. Tool paths are relative to the Artifact, for example src/lib.rs. Submit \
GREEN when no item is clearly violated. Otherwise submit RED with up to 20 violations, the most \
important first, each with the item id, a path:line and one sentence on what to change."""

[evals.follows-platform.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.follows-platform.fail_schema]
type = "object"
required = ["violations"]
additionalProperties = false

[evals.follows-platform.fail_schema.properties.violations]
type = "array"
minItems = 1
maxItems = 20

[evals.follows-platform.fail_schema.properties.violations.items]
type = "object"
properties.item = { type = "string", minLength = 1 }
properties.where = { type = "string", minLength = 1 }
properties.change = { type = "string", minLength = 1 }
required = ["item", "where", "change"]
additionalProperties = false

[evals.fmt]
title = "The Rust formatting check passes"
profile = { kind = "runtime", command = "cargo", args = ["fmt", "--check", "-p", "artifactize-mcp"], timeout_ms = 60000 }

[evals.fmt.payload]
instruction = "Check the formatting of {engine::mcp}."

[evals.clippy]
title = "Clippy passes for every Rust target"
profile = { kind = "runtime", command = "cargo", args = ["clippy", "--locked", "-p", "artifactize-mcp", "--all-targets", "--", "-D", "warnings"], timeout_ms = 1800000 }

[evals.clippy.payload]
instruction = "Check every Rust target of {engine::mcp} with {engine::core} with the workspace {engine::cargo-manifest} and {engine::cargo-lock}, treating every clippy warning as an error."

[evals.tests]
title = "The Rust crate tests pass"
profile = { kind = "runtime", command = "cargo", args = ["test", "--locked", "-p", "artifactize-mcp"], timeout_ms = 1800000 }

[evals.tests.payload]
instruction = "Run the tests of {engine::mcp} with {engine::core} with the workspace {engine::cargo-manifest} and {engine::cargo-lock}. Fixtures build or declare every executable they use and own their resources."
