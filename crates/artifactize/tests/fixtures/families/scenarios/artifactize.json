{
  "name": "scenarios",
  "family": {
    "instances": "instances.json",
    "params": {
      "title": "Check the scenario",
      "detailIds": [
        "overview"
      ],
      "expected": "READY"
    },
    "variants": {
      "searchable": {
        "detailIds": [
          "message",
          "query"
        ],
        "expected": "SEARCH"
      }
    }
  },
  "staleKey": {
    "script": {
      "command": "/bin/sh",
      "args": [
        "stale_key.sh"
      ],
      "inputs": [
        "check.sh"
      ]
    }
  },
  "views": {
    "agentTools": {
      "detail": {
        "description": "Read a detail of {artifactName}.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "enum": {
                "$param": "/detailIds"
              }
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "command": "/bin/cat",
        "args": [
          {
            "$param": "/file"
          }
        ],
        "protocol": "plain"
      }
    }
  },
  "evals": [
    {
      "id": "review",
      "title": {
        "$param": "/title"
      },
      "profile": {
        "kind": "runtime",
        "command": "/bin/sh",
        "args": [
          "check.sh",
          {
            "$param": "/input"
          },
          {
            "$param": "/expected"
          }
        ],
        "timeoutMs": 5000
      },
      "payload": {
        "instruction": {
          "$param": "/instruction"
        }
      }
    }
  ]
}
