{
  "name": "scenarios",
  "family": {
    "instances": "instances.json",
    "params": {
      "title": "Check the scenario",
      "detailIds": [
        "overview"
      ],
      "expected": "READY"
    },
    "variants": {
      "searchable": {
        "detailIds": [
          "message",
          "query"
        ],
        "expected": "SEARCH"
      }
    }
  },
  "stale": {
    "kind": "identity",
    "script": {
      "command": "/bin/sh",
      "args": ["identity.sh"]
    },
    "inputs": [
      "check.sh"
    ]
  },
  "views": {
    "agentTools": {
      "detail": {
        "metadata": {
          "description": "Read a detail of {artifactName}.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "id": {
                "enum": {
                  "$param": "/detailIds"
                }
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          },
          "resultKinds": [
            "text"
          ]
        },
        "script": {
          "command": "/bin/cat",
          "args": [
            {
              "$param": "/file"
            }
          ]
        }
      }
    }
  },
  "evals": [
    {
      "id": "review",
      "title": {
        "$param": "/title"
      },
      "profile": {
        "kind": "runtime",
        "command": "/bin/sh",
        "args": [
          "check.sh",
          {
            "$param": "/input"
          },
          {
            "$param": "/expected"
          }
        ],
        "timeoutMs": 5000
      },
      "payload": {
        "instruction": {
          "$param": "/instruction"
        }
      }
    }
  ]
}
