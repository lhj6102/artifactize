{
  "name": "review",
  "mounts": { "source": "input" },
  "stale": {
    "kind": "identity",
    "script": { "command": "hook.sh", "args": [] },
    "inputs": ["hook.sh"],
    "timeoutMs": 1000
  },
  "envRequirements": {
    "ready": {
      "description": "The environment is ready",
      "script": { "command": "sh", "args": ["hook.sh"] },
      "timeoutMs": 1000
    }
  },
  "views": {
    "agentTools": {
      "read": {
        "metadata": {
          "description": "Read {artifactName}",
          "inputSchema": { "type": "object" },
          "resultKinds": ["text"],
          "observation": "content",
          "timeoutMs": 1000
        },
        "script": { "command": "sh", "args": ["hook.sh"] }
      }
    },
    "humanTools": {
      "read": {
        "metadata": {
          "description": "Read {artifactName}",
          "inputSchema": { "type": "object" },
          "resultKinds": ["text"],
          "observation": "content"
        },
        "script": { "command": "sh", "args": ["hook.sh"] }
      }
    }
  },
  "critics": [
    {
      "id": "runtime",
      "title": "Check input",
      "profile": { "kind": "runtime", "command": "sh", "args": ["hook.sh"], "timeoutMs": 1000 },
      "payload": { "instruction": "Check {source}.", "owner": { "literal": "$HOME" } }
    },
    {
      "id": "agent",
      "title": "Review input",
      "profile": { "kind": "agent", "provider": "not-called", "model": "not-called", "reasoning": "high" },
      "payload": { "instruction": "Inspect {source}." },
      "passSchema": { "properties": { "notes": { "type": "string" } } },
      "resultCheck": { "script": { "command": "sh", "args": ["hook.sh"] }, "timeoutMs": 1000 }
    },
    {
      "id": "human",
      "title": "Inspect input",
      "profile": { "kind": "human" },
      "payload": { "instruction": "Inspect {source}." }
    }
  ]
}
