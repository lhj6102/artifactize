name = "cli"
fingerprint = { files = ["."] }

[views.agent_tools]
list = { builtin = "list" }
glob = { builtin = "glob" }
grep = { builtin = "grep" }
read = { builtin = "read" }

[evals.follows-style]
title = "The CLI code follows the code checklist"
profile = { kind = "agent", backend = "codex", model = "gpt-6-luna", reasoning = "max", timeout_ms = 1800000, max_tool_calls = 120, max_tokens = 8000000 }

[evals.follows-style.profile_variants]
sol-medium = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "medium", timeout_ms = 1800000, max_tool_calls = 120, max_tokens = 4000000 }
sol-max = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "max", timeout_ms = 1800000, max_tool_calls = 120, max_tokens = 4000000 }

[evals.follows-style.payload]
instruction = """
Read the checklist {code-style} with read_style_code-style. Then review the Rust code of {cli} (src/ \
and Cargo.toml; tests/ only for M-TAUTOLOGICAL-TESTS) against every item, using list_cli, glob_cli, \
grep_cli and read_cli. Tool paths are relative to the Artifact, for example src/cache.rs. Submit \
GREEN when no item is clearly violated. Otherwise submit RED with up to 20 violations, the most \
important first, each with the item id, a path:line and one sentence on what to change."""

[evals.follows-style.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.follows-style.fail_schema]
type = "object"
required = ["violations"]
additionalProperties = false

[evals.follows-style.fail_schema.properties.violations]
type = "array"
minItems = 1
maxItems = 20

[evals.follows-style.fail_schema.properties.violations.items]
type = "object"
properties.item = { type = "string", minLength = 1 }
properties.where = { type = "string", minLength = 1 }
properties.change = { type = "string", minLength = 1 }
required = ["item", "where", "change"]
additionalProperties = false
