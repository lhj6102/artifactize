name = "engine-terminal"
select = ["src/terminal.rs", "src/terminal", "src/platform/terminal.rs", "src/platform/terminal"]

[views.agent_tools]
list = { builtin = "list" }
glob = { builtin = "glob" }
grep = { builtin = "grep" }
read = { builtin = "read" }

[evals.keeps-restore-promises]
title = "A terminal restore runs nothing unconfirmed and reads no conversation"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.keeps-restore-promises.payload]
instruction = """
Review the worktree terminals of {engine-terminal} (src/terminal.rs, src/terminal/, src/platform/terminal.rs, src/platform/terminal/) for what a gone terminal offers and runs. Tool paths are relative to the Artifact, for example src/terminal/metadata.rs. Check every promise:
- R-CONFIRM: nothing from a restore offer runs until the person sends a choice; keeping the fresh shell runs nothing, and an offer is used at most once.
- R-ARGV: a rerun or resume runs as an argument vector in the remembered directory (the worktree when it is unknown), never as shell source.
- R-CERTAIN: a resume names a session ID only when it is known for certain: an exact resume or session argument of the remembered command whose session metadata (Claude Code project JSONL sessionId, Codex rollout session_meta id) has that ID and the same directory. A matching directory or the newest file alone is not proof; otherwise the offer is the harness's latest session, labelled as the latest.
- R-METADATA-ONLY: session discovery reads only those metadata fields; messages, tool calls and other conversation content are never kept, shown or interpreted.
- R-PER-WORKTREE: restore metadata (last directory, foreground command, harness, session ID) belongs to the worktree's Git identity, not its branch, is saved while the terminal runs, and a crash or reboot leaves the previous complete version, never a partial one.
Submit GREEN when no promise is clearly broken. Otherwise submit RED with up to 20 violations, the most important first, each with the promise id (item), a path:line (where) and one sentence on what to change."""

[evals.keeps-restore-promises.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.keeps-restore-promises.fail_schema]
type = "object"
required = ["violations"]
additionalProperties = false

[evals.keeps-restore-promises.fail_schema.properties.violations]
type = "array"
minItems = 1
maxItems = 20

[evals.keeps-restore-promises.fail_schema.properties.violations.items]
type = "object"
properties.item = { type = "string", minLength = 1 }
properties.where = { type = "string", minLength = 1 }
properties.change = { type = "string", minLength = 1 }
required = ["item", "where", "change"]
additionalProperties = false
