tool review = {
  agent read = command(
      command = "sh",
      args = ["hook.sh"],
      protocol = "plain",
      description = "Read @{artf self}",
      input_schema = { type = "object" },
      timeout_ms = 1000,
    )
  human read = command(command = "sh", args = ["hook.sh"], description = "Read @{artf self}", kind = "output")
}

artf review : review = {
  fingerprint = script(command = "hook.sh", args = [], files = ["hook.sh"], timeout_ms = 1000)
  path = "review/"

  eval agent : not-called = {
    title = "Review input"
    red_at = "P1"
    instruction = "Inspect @{artf input}."
  }

  eval human : human = {
    title = "Inspect input"
    instruction = "Inspect @{artf input}."
  }

  eval runtime : runtime(command = "sh", args = ["hook.sh"], timeout_ms = 1000) = {
    title = "Check input"
    instruction = "Check input."
    inputs = [input]
  }
}
