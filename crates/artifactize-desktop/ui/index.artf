name = "desktop-ui"

[views.agent_tools]
list = { builtin = "list" }
glob = { builtin = "glob" }
grep = { builtin = "grep" }
read = { builtin = "read" }

[evals.follows-frontend-style]
title = "The desktop UI follows the frontend checklist"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.follows-frontend-style.profile_variants]
sol-medium = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "medium", timeout_ms = 1800000 }
sol-max = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "max", timeout_ms = 1800000 }
luna-max = { kind = "agent", backend = "codex", model = "gpt-6-luna", reasoning = "max", timeout_ms = 1800000 }

[evals.follows-frontend-style.payload]
instruction = """
Read the checklist {rules-frontend-style} and the TEST- rules of \
{rules-code-style}. Then review the Svelte and TypeScript \
of {desktop-ui}: its src folder (the generated bindings in src/ipc/bindings.ts are excluded; src/ipc/client.ts is not) and its build configuration, but not the end-to-end tests in e2e, against \
every frontend item, and its tests and test helpers against every TEST- rule. The UI gets all \
domain state and decisions from the library {engine-core} through the IPC bindings: report any that it \
re-implements (read the library). Tool paths are relative to the Artifact, for example src/lib.rs. Submit GREEN when no item is clearly violated. Otherwise submit RED with up to 20 violations, the most important first, each with the item id, a path:line and one sentence on what to change."""

[evals.follows-frontend-style.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.follows-frontend-style.fail_schema]
type = "object"
required = ["violations"]
additionalProperties = false

[evals.follows-frontend-style.fail_schema.properties.violations]
type = "array"
minItems = 1
maxItems = 20

[evals.follows-frontend-style.fail_schema.properties.violations.items]
type = "object"
properties.item = { type = "string", minLength = 1 }
properties.where = { type = "string", minLength = 1 }
properties.change = { type = "string", minLength = 1 }
required = ["item", "where", "change"]
additionalProperties = false

[evals.lint]
title = "The mechanical frontend rules and the type check pass"
profile = { kind = "runtime", command = "pnpm", args = ["lint"], timeout_ms = 600000 }

[evals.lint.payload]
instruction = """
Run eslint (no inline config; Svelte recommended rules, prefer-writable-derived, \
no-unnecessary-state-wrap, require-each-key, and a $effect without an // EFFECT: comment) over \
the source and build configuration of {desktop-ui}, then svelte-check over the same files. The generated bindings and the end-to-end tests are excluded."""

[evals.tokens-match-design]
title = "The UI's tokens are the design's tokens"
profile = { kind = "runtime", command = "node", args = ["{desktop-design-check}", "tokens", "{desktop-design}/tokens.css", "src/tokens.css"], timeout_ms = 30000 }

[evals.tokens-match-design.payload]
instruction = """
Check with {desktop-design-check} that src/tokens.css of {desktop-ui} declares the same custom properties with the \
same values and the same one dark scheme, as tokens.css of {desktop-design}."""

[evals.follows-design]
title = "The desktop UI follows the design's screens and rules"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.follows-design.profile_variants]
sol-medium = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "medium", timeout_ms = 1800000 }
sol-max = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "max", timeout_ms = 1800000 }

[evals.follows-design.payload]
instruction = """
Read the design {desktop-design}: index.html (the tokens by role and the rules of the system, D-SYS-*), then each \
screen page (monitor.html, current.html, detail.html, review.html, settings.html, overlays.html), whose figures \
are drawn with mock.css and whose D- rules say what must hold on that screen. Then review the Svelte and CSS of \
{desktop-ui}: src/app.css and src/tokens.css, src/App.svelte, and the components under src/monitor, src/review, \
src/settings and src/shell (the generated bindings in src/ipc are not UI; the tests and e2e are reviewed \
elsewhere). For each D- rule, find the component or stylesheet that renders what the rule describes and judge \
whether it holds: the surfaces, lines and tokens it names (a component declares no colour literal and uses a \
token for the role the rule gives it), the sizes within the tolerances the rule states, the order and anatomy of \
the elements, the treatment of selection, hover and focus, and what the rule says to avoid. Mock markup need not \
be copied: the app renders the same anatomy with its own components. Behaviour is reviewed by other evals; judge \
appearance and arrangement only, and do not invent requirements the pages do not state. Submit GREEN when no \
rule is clearly violated. Otherwise submit RED with up to 20 violations, the most important first, each with the \
rule id (item), a path:line in {desktop-ui} (where) and one sentence on what to change in the UI."""

[evals.follows-design.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.follows-design.fail_schema]
type = "object"
required = ["violations"]
additionalProperties = false

[evals.follows-design.fail_schema.properties.violations]
type = "array"
minItems = 1
maxItems = 20

[evals.follows-design.fail_schema.properties.violations.items]
type = "object"
properties.item = { type = "string", minLength = 1 }
properties.where = { type = "string", minLength = 1 }
properties.change = { type = "string", minLength = 1 }
required = ["item", "where", "change"]
additionalProperties = false
