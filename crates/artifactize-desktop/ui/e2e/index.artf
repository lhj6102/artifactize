name = "desktop-e2e"

# The suite drives the built app: it depends on the whole desktop crate (backend, UI, harness
# configuration) and on the library the backend calls, not only on the tests.
[fingerprint.script]
command = "node"
args = [
  "{desktop}/fingerprint.mjs",
  ".",
  "{desktop}",
  "{core}/src",
  "{core}/Cargo.toml",
  "{tools}/src",
  "{tools}/Cargo.toml",
]

[views.agent_tools]
list = { builtin = "list" }
glob = { builtin = "glob" }
grep = { builtin = "grep" }
read = { builtin = "read" }

[evals.covers-journeys]
title = "The tests cover every journey and every edge of the UX"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.covers-journeys.profile_variants]
sol-medium = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "medium", timeout_ms = 1800000 }
sol-max = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "max", timeout_ms = 1800000 }
luna-max = { kind = "agent", backend = "codex", model = "gpt-6-luna", reasoning = "max", timeout_ms = 1800000 }

[evals.covers-journeys.payload]
instruction = """
Read the journeys {ux-features} with read_features_ux-features and the graph {ux-graph} with \
read_graph_ux-graph. Review the tests of {desktop-e2e} using list_desktop-e2e, glob_desktop-e2e, \
grep_desktop-e2e and read_desktop-e2e. Evaluate UX coverage only: every journey (J- id) has a test \
that performs its prescribed actions and checks its final outcome; every edge (E- id) has an \
assertion that the transition happens, not only a comment naming it. Check that the assertions \
express the actual feature and graph requirements, neither a weaker substitute nor an invented \
requirement. Code style and E2E execution isolation have separate evals; do not duplicate those \
reviews here. Submit GREEN when every journey and edge is meaningfully covered. Otherwise submit \
RED with up to 20 coverage gaps, the most important first, each with the journey or edge id \
(item), a test path:line (where) and one sentence on what to add or fix."""

[evals.covers-journeys.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.covers-journeys.fail_schema]
type = "object"
required = ["gaps"]
additionalProperties = false

[evals.covers-journeys.fail_schema.properties.gaps]
type = "array"
minItems = 1
maxItems = 20

[evals.covers-journeys.fail_schema.properties.gaps.items]
type = "object"
properties.item = { type = "string", minLength = 1 }
properties.where = { type = "string", minLength = 1 }
properties.change = { type = "string", minLength = 1 }
required = ["item", "where", "change"]
additionalProperties = false

[evals.follows-style]
title = "The E2E code follows the shared test-writing rules"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.follows-style.payload]
instruction = """
Read {code-style} with read_style_code-style. Review all TypeScript tests, helpers and runner \
code owned by {desktop-e2e}, using list_desktop-e2e, glob_desktop-e2e, grep_desktop-e2e and \
read_desktop-e2e. Apply every language-neutral TEST- rule and M-TAUTOLOGICAL-TESTS: exact async \
states, controlled ordering and expiry, read-only observation, fixture ownership and cleanup, \
self-contained build inputs, observable seams without over-verification, and independent expected \
results. The other Rust-specific checklist items do not apply to TypeScript. Judge the code \
against these shared rules only; UX coverage and the E2E-specific execution contract have their \
own evals. Submit GREEN when no applicable rule is clearly violated. Otherwise submit RED with \
up to 20 violations, most important first, each with the rule id (item), a path:line (where) \
and one sentence on what to change.
"""
pass_schema = { type = "object", properties = { summary = { type = "string", minLength = 1 } }, required = ["summary"], additionalProperties = false }
fail_schema = { type = "object", properties = { violations = { type = "array", minItems = 1, maxItems = 20, items = { type = "object", properties = { item = { type = "string", minLength = 1 }, where = { type = "string", minLength = 1 }, change = { type = "string", minLength = 1 } }, required = ["item", "where", "change"], additionalProperties = false } } }, required = ["violations"], additionalProperties = false }

[evals.follows-e2e-rules]
title = "The real-app E2E tests are isolated, causally observed and complete"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.follows-e2e-rules.payload]
instruction = """
Review all tests, fixture helpers and execution/cleanup code owned by {desktop-e2e}, using \
list_desktop-e2e, glob_desktop-e2e, grep_desktop-e2e and read_desktop-e2e. These are this \
Artifact's E2E-writing rules, not a request for new product features or a new test framework:

- E2E-INDEPENDENT: each case is valid on its own and does not rely on the order, success or \
  leftovers of another case. Independently launched suites and other evals must not interfere \
  with it. A suite may own an immutable built candidate, but mutable app/test state is scoped \
  to its actual owner, not accidentally shared between cases or evaluations.
- E2E-ISOLATED-RESOURCES: identify every mutable external resource the scenario uses, including \
  app/session state, repository and state directories, credentials/environment inputs, display \
  and input focus, IPC endpoints and callback ports. Keep unrelated tests and the user's live \
  environment untouched. Fixed-name or fixed-port resources require a real isolation boundary \
  for the participating processes; choosing a unique test label alone is not isolation. \
  Declared immutable inputs may be shared. Do not serialize all evals or add a global lock \
  merely to hide cross-test interference.
- E2E-COMPLETE-LIFETIME: ownership starts when acquisition or launch is requested, including \
  pending detached handoffs, and lasts until every owned operation and process has completed \
  or another owner has actually accepted responsibility. Close admission before shutdown; \
  settle in-flight work and drain output before releasing its resources. Normal return, test \
  failure, cancellation and startup failure obey the same ownership contract. A verdict, \
  cancellation request, launcher exit or published PID alone is not a cleanup acknowledgement. \
  Never delete a fixture or executable snapshot while its users can still be alive; preserve \
  inputs and report cleanup failures rather than swallowing them in finally.
- E2E-REAL-APP: drive the actual built app through its real UI and public command/IPC routes. \
  Fixtures may control declared external services and scenario inputs, but must not replace \
  the product behavior being evaluated. Observing the app must not alter its DOM behavior, \
  handlers, IPC dispatch or production decisions to obtain a passing result.
- E2E-CAUSAL-OUTCOMES: tie an assertion to the action performed in that case and its observable \
  completed outcome. Dispatch counts, pre-existing matching text, a merely accepted command, \
  arbitrary sleeps and a transient render are not substitutes for the resulting transition. \
  A read-only activity probe must also be shown to observe a real successful operation, so \
  an unwired always-zero probe cannot prove that a forbidden action did not happen. Assert \
  user-visible semantics, not exact mounted counts or private implementation steps.
- E2E-PORTABLE-BOUNDARY: keep native OS setup and teardown in designated shared OS helpers. \
  Other test code uses their portable API rather than independently handling native paths, \
  process identities, signals, permissions or environment lookup. Platform-specific harnesses \
  state their required capabilities; setup failures remain explicit failures, not skipped \
  coverage, silent success or modifications to host security policy. The actual process doing \
  the work must run inside the declared fixture boundary, not just its launcher.
- E2E-RUNNER-COMPLETION: the runner remains alive and owns the suite until its real exit and \
  cleanup are observed. Do not rely on an incidental timer, inherited handle or unrelated \
  activity to keep an awaited operation alive. Preserve setup/test/cleanup errors and return \
  an exit status reflecting the actual outcome; incomplete or cancelled execution is not PASS.

Judge these execution/isolation contracts, not journey completeness or general code style, \
which have separate evals. Report concrete violations with a plausible action/interleaving \
and affected resource, not hypothetical cheating or demands to test every possible permutation. \
Require only the observable seams needed to establish these contracts; do not pin private \
counts or prescribe a particular class, algorithm or additional configuration knob. Submit \
GREEN when none of these rules is clearly violated. Otherwise submit RED with up to 20 \
violations, most important first, each with the E2E rule id (item), a path:line and failure \
scenario (where), and one sentence on what to change.
"""
pass_schema = { type = "object", properties = { summary = { type = "string", minLength = 1 } }, required = ["summary"], additionalProperties = false }
fail_schema = { type = "object", properties = { violations = { type = "array", minItems = 1, maxItems = 20, items = { type = "object", properties = { item = { type = "string", minLength = 1 }, where = { type = "string", minLength = 1 }, change = { type = "string", minLength = 1 } }, required = ["item", "where", "change"], additionalProperties = false } } }, required = ["violations"], additionalProperties = false }

[evals.edge-ids]
title = "Every edge id of the UX graph appears in the end-to-end tests"
profile = { kind = "runtime", command = "node", args = ["check-edges.ts", "{ux-graph}", "."], timeout_ms = 30000 }

[evals.edge-ids.payload]
instruction = """
Check that every edge id of {ux-graph} is cited in the tests of {desktop-e2e}."""

[evals.lint]
title = "The end-to-end TypeScript lint passes"
profile = { kind = "runtime", command = "pnpm", args = ["lint"], timeout_ms = 600000 }

[evals.lint.payload]
instruction = "Run TypeScript eslint with no inline config over every test and helper of {desktop-e2e}."

[evals.suite-passes]
title = "The end-to-end suite passes on a headless display"
profile = { kind = "runtime", command = "pnpm", args = ["-C", "..", "e2e"], timeout_ms = 1800000 }

[evals.suite-passes.payload]
instruction = """
Build the CLI and app from {cli}, {tui}, {core}, {tools} and {desktop}, then run the tests of \
{desktop-e2e} against that owned candidate on private Xvfb displays. Each fixture owns its \
resources while the Rust tests run concurrently."""
