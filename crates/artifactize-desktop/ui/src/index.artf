name = "desktop-ui"

# The lint and type check read the folder's configuration, the end-to-end tests and the
# harness besides these files: a change to any of them is a change to the result.
[fingerprint.script]
command = "node"
args = [
  "{desktop}/fingerprint.mjs",
  ".",
  "{desktop}/ui/eslint.config.js",
  "{desktop}/ui/lint",
  "{desktop}/ui/package.json",
  "{desktop}/ui/pnpm-lock.yaml",
  "{desktop}/ui/tsconfig.json",
  "{desktop}/ui/svelte.config.js",
  "{desktop}/ui/vite.config.ts",
  "{desktop}/ui/e2e",
  "{desktop}/harness",
]

[views.agent_tools]
list = { builtin = "list" }
glob = { builtin = "glob" }
grep = { builtin = "grep" }
read = { builtin = "read" }

[evals.follows-frontend-style]
title = "The desktop UI follows the frontend checklist"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.follows-frontend-style.profile_variants]
sol-medium = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "medium", timeout_ms = 1800000 }
sol-max = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "max", timeout_ms = 1800000 }
luna-max = { kind = "agent", backend = "codex", model = "gpt-6-luna", reasoning = "max", timeout_ms = 1800000 }

[evals.follows-frontend-style.payload]
instruction = """
Read the checklist {frontend-style} with read_frontend_frontend-style and the TEST- rules of \
{code-style} with read_style_code-style. Then review the Svelte and TypeScript \
of {desktop-ui} (the generated bindings in ipc/bindings.ts are excluded; ipc/client.ts is not) against \
every frontend item, and its tests and test helpers against every TEST- rule, using list_desktop-ui, \
glob_desktop-ui, grep_desktop-ui and read_desktop-ui. The UI gets all \
domain state and decisions from the library {core} through the IPC bindings: report any that it \
re-implements (read the library with list_core, glob_core, grep_core and read_core). Tool paths are relative to the Artifact, for example src/lib.rs. Submit GREEN when no item is clearly violated. Otherwise submit RED with up to 20 violations, the most important first, each with the item id, a path:line and one sentence on what to change."""

[evals.follows-frontend-style.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.follows-frontend-style.fail_schema]
type = "object"
required = ["violations"]
additionalProperties = false

[evals.follows-frontend-style.fail_schema.properties.violations]
type = "array"
minItems = 1
maxItems = 20

[evals.follows-frontend-style.fail_schema.properties.violations.items]
type = "object"
properties.item = { type = "string", minLength = 1 }
properties.where = { type = "string", minLength = 1 }
properties.change = { type = "string", minLength = 1 }
required = ["item", "where", "change"]
additionalProperties = false

[evals.lint]
title = "The mechanical frontend rules and the type check pass"
profile = { kind = "runtime", command = "pnpm", args = ["-C", "..", "lint"], timeout_ms = 600000 }

[evals.lint.payload]
instruction = """
Run eslint (no inline config; Svelte recommended rules, prefer-writable-derived, \
no-unnecessary-state-wrap, require-each-key, and a $effect without an // EFFECT: comment) over \
{desktop-ui} and then svelte-check. The generated bindings are excluded."""
