diff --git a/dist/cjs/index.js b/dist/cjs/index.js
index 7707403ba38c4493db29a82e50802051f58d64e0..1abc3804ad5bfc619b3eff3a90e29f0d88427890 100644
--- a/dist/cjs/index.js
+++ b/dist/cjs/index.js
@@ -4668,17 +4668,25 @@ async function cleanup(browser) {
     const launcher = activeLaunchers.get(browser);
     if (launcher) {
         const service = activeServices.get(browser);
-        const svc = service;
+        const failures = [];
         try {
-            await svc?.afterSession?.();
+            await service?.afterSession?.();
         }
-        catch (e) {
-            log.warn(`service.afterSession() failed during cleanup: ${nativeUtils.errorMessage(e)}`);
+        catch (error) {
+            failures.push(error);
         }
-        finally {
-            activeServices.delete(browser);
+        try {
+            // A resolved cleanup is permission to remove the app's fixture inputs.
+            // Preserve ownership on any failure, including bounded shutdown timeout.
+            await nativeUtils.boundedOnComplete(launcher, 'cleanup', log, { rethrow: true });
+        }
+        catch (error) {
+            failures.push(error);
+        }
+        if (failures.length) {
+            throw new AggregateError(failures, 'Tauri standalone session cleanup failed');
         }
-        await nativeUtils.boundedOnComplete(launcher, 'cleanup', log);
+        activeServices.delete(browser);
         activeLaunchers.delete(browser);
         log.debug('Tauri standalone session cleaned up');
     }
