{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Artifactize",
  "identifier": "dev.artifactize.desktop",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Artifactize",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../assets/brand/favicon.png"]
  }
}
