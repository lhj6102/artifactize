name = "desktop-backend"

[views.agent_tools]
list = { builtin = "list" }
glob = { builtin = "glob" }
grep = { builtin = "grep" }
read = { builtin = "read" }

[evals.follows-style]
title = "The desktop backend follows the code checklist"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.follows-style.profile_variants]
sol-medium = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "medium", timeout_ms = 1800000 }
sol-max = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "max", timeout_ms = 1800000 }
luna-max = { kind = "agent", backend = "codex", model = "gpt-6-luna", reasoning = "max", timeout_ms = 1800000 }

[evals.follows-style.payload]
instruction = """
Read the checklist {rules-code-style}. Then review the Rust code of {desktop-backend} \
(the files here) against every item. Review the Rust integration tests of {desktop} \
(tests/) for M-TAUTOLOGICAL-TESTS and every TEST- rule. The backend only hands data of the library {engine-core} to the \
frontend as typed commands and events: also report logic that re-implements something the library \
already does (read it). Tool paths are relative to the Artifact, for example src/lib.rs. Submit GREEN when no item is clearly violated. Otherwise submit RED with up to 20 violations, the most important first, each with the item id, a path:line and one sentence on what to change."""

[evals.follows-style.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.follows-style.fail_schema]
type = "object"
required = ["violations"]
additionalProperties = false

[evals.follows-style.fail_schema.properties.violations]
type = "array"
minItems = 1
maxItems = 20

[evals.follows-style.fail_schema.properties.violations.items]
type = "object"
properties.item = { type = "string", minLength = 1 }
properties.where = { type = "string", minLength = 1 }
properties.change = { type = "string", minLength = 1 }
required = ["item", "where", "change"]
additionalProperties = false

[evals.follows-platform]
title = "The desktop backend follows the platform checklist"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.follows-platform.profile_variants]
sol-medium = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "medium", timeout_ms = 1800000 }
sol-max = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "max", timeout_ms = 1800000 }
luna-max = { kind = "agent", backend = "codex", model = "gpt-6-luna", reasoning = "max", timeout_ms = 1800000 }

[evals.follows-platform.payload]
instruction = """
Read the checklist {rules-platform}. Then review the Rust code of {desktop-backend} \
(src/) against every P- item, and the library {engine-core} where the backend calls it. Tool paths are relative to the Artifact, for example src/lib.rs. Submit GREEN when no item is clearly violated. Otherwise submit RED with up to 20 violations, the most important first, each with the item id, a path:line and one sentence on what to change."""

[evals.follows-platform.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.follows-platform.fail_schema]
type = "object"
required = ["violations"]
additionalProperties = false

[evals.follows-platform.fail_schema.properties.violations]
type = "array"
minItems = 1
maxItems = 20

[evals.follows-platform.fail_schema.properties.violations.items]
type = "object"
properties.item = { type = "string", minLength = 1 }
properties.where = { type = "string", minLength = 1 }
properties.change = { type = "string", minLength = 1 }
required = ["item", "where", "change"]
additionalProperties = false
