name = "desktop"
# The journeys are checked in the running app, built from this crate and the library it calls:
# all of it is an input, not only the files this declaration owns.
[fingerprint.script]
command = "node"
args = [
  "fingerprint.mjs",
  ".",
  "{core}/src",
  "{core}/Cargo.toml",
  "{tools}/src",
  "{tools}/Cargo.toml",
  "{graph}/Cargo.toml",
  "{graph}/Cargo.lock",
]

# The app runs headless for the whole review. start snapshots the explicitly prepared
# candidate manifest into its own session; it never consumes shared Cargo output names.
[views.agent_tools]
list = { builtin = "list" }
glob = { builtin = "glob" }
grep = { builtin = "grep" }
read = { builtin = "read" }

[views.agent_sessions.app]
start = { command = "node", args = ["harness/harness.mts", "start"], execution_paths = [
  "crates/artifactize-desktop/harness",
  "crates/artifactize-desktop/ui/e2e",
] }
stop = { command = "node", args = ["harness/harness.mts", "stop"], execution_paths = ["crates/artifactize-desktop/harness"] }

[views.agent_tools.snapshot]
session = "app"
description = "What the app's window shows now: its focused element, its visible controls each with a number, role, name and state, and its text."
command = "node"
args = ["harness/harness.mts", "snapshot"]
protocol = "json"

[views.agent_tools.act]
session = "app"
description = "Act in the app's window: click a control by its number from the latest snapshot, type text (into the numbered control, or the focused one), or press a key such as Enter, Escape, ArrowDown, j or Control+k. Answers with the new snapshot."
command = "node"
args = ["harness/harness.mts", "act"]
protocol = "json"

[views.agent_tools.act.input_schema]
type = "object"
properties.action = { enum = ["click", "type", "key"] }
properties.element = { type = "integer", minimum = 1, description = "Control number from the latest snapshot; required for click." }
properties.text = { type = "string", description = "Text to type; required for type." }
properties.key = { type = "string", description = "One key, or modifiers joined with + before one key; required for key." }
required = ["action"]
additionalProperties = false

[views.agent_tools.cli]
session = "app"
description = "Run the artifactize CLI against the app's repository and state from another process (for example `request list --json`, `verify --all`, `request claim ID`), to change state the window must then show. Answers with exit code, stdout and stderr."
command = "node"
args = ["harness/harness.mts", "cli"]
protocol = "json"

[views.agent_tools.cli.input_schema]
type = "object"
properties.args = { type = "array", items = { type = "string" }, minItems = 1 }
required = ["args"]
additionalProperties = false

[views.agent_tools.launch]
session = "app"
description = "Restart the real headless desktop app with its actual monitor, review or graph launch mode. Graph uses current declarations and fresh state with no saved Run. Answers with the new window snapshot; builds nothing."
command = "node"
args = ["harness/harness.mts", "launch"]
protocol = "json"
input_schema = { type = "object", properties = { screen = { enum = ["monitor", "review", "graph"] } }, required = ["screen"], additionalProperties = false }

[views.agent_tools.change_declaration]
session = "app"
description = "Change docs/lint's title in the private fixture's actual declaration, without re-verifying. Refresh the current graph to observe the change rather than a saved Run."
command = "node"
args = ["harness/harness.mts", "change-declaration"]
protocol = "json"
input_schema = { type = "object", properties = {}, additionalProperties = false }

[evals.ready]
title = "The backend, the UI and the journeys are ready"
profile = { kind = "dependency", depends_on = ["desktop-backend", "desktop-ui", "ux-features"] }

[evals.journeys]
title = "Every journey can be completed in the running app"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 3600000 }

[evals.journeys.profile_variants]
sol-medium = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "medium", timeout_ms = 3600000 }
sol-max = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "max", timeout_ms = 3600000 }
luna-max = { kind = "agent", backend = "codex", model = "gpt-6-luna", reasoning = "max", timeout_ms = 3600000 }

[evals.journeys.payload]
instruction = """
Read the journeys {ux-features} with read_features_ux-features. The app of {desktop} is running \
headless; use snapshot_desktop to see its window, act_desktop to click, type and press keys, and \
cli_desktop to change its repository state from another process (the repository holds the Artifacts \
release, ship and docs, with a waiting Human sign-off on release). Use launch_desktop for the real \
monitor/review/graph launch routes or to restart after quitting, and change_declaration_desktop to \
change the private fixture's docs/lint title before testing a current-graph reload. Complete every journey (J- id) \
in the running app and check that it ends in what the journey says. Journeys that need a network, \
a Codex account or a remote store (J-SET-CODEX, J-SET-MODELS, J-SET-REMOTE) are checked up to the \
point where the app asks for what it needs. Submit GREEN when every journey can be completed. \
Otherwise submit RED with up to 20 failures, the most important first, each with the journey id \
(item), what you did and saw (where) and one sentence on what to change."""

[evals.journeys.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.journeys.fail_schema]
type = "object"
required = ["failures"]
additionalProperties = false

[evals.journeys.fail_schema.properties.failures]
type = "array"
minItems = 1
maxItems = 20

[evals.journeys.fail_schema.properties.failures.items]
type = "object"
properties.item = { type = "string", minLength = 1 }
properties.where = { type = "string", minLength = 1 }
properties.change = { type = "string", minLength = 1 }
required = ["item", "where", "change"]
additionalProperties = false


[evals.lint]
title = "The desktop-owned TypeScript automation and build configuration lint passes"
profile = { kind = "runtime", command = "pnpm", args = ["lint"], timeout_ms = 600000 }
payload.instruction = "Run eslint with no inline config over the TypeScript directly owned by {desktop}: its automation harness and frontend build configuration."

[evals.follows-test-rules]
title = "The desktop automation harness follows the test rules"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000 }
payload.instruction = """
Read the TEST- rules of {code-style} with read_style_code-style. Review the automation harness owned by {desktop} (harness/), using list_desktop, glob_desktop, grep_desktop and read_desktop. The tests of {desktop-ui} and {desktop-e2e} have their own reviews: do not duplicate them. Check every TEST- rule: exact async states, controlled ordering or expiry times, read-only observations, owned processes/connections/temporary files and cleanup, declared executables and inputs, and observable seams without over-verification. Submit GREEN when none is clearly violated. Otherwise submit RED with up to 20 violations, each with the TEST- rule id (item), a path:line (where), and one sentence on what to change.
"""
pass_schema = { type = "object", properties = { summary = { type = "string", minLength = 1 } }, required = ["summary"], additionalProperties = false }
fail_schema = { type = "object", properties = { violations = { type = "array", minItems = 1, maxItems = 20, items = { type = "object", properties = { item = { type = "string", minLength = 1 }, where = { type = "string", minLength = 1 }, change = { type = "string", minLength = 1 } }, required = ["item", "where", "change"], additionalProperties = false } } }, required = ["violations"], additionalProperties = false }

[evals.fmt]
title = "The Rust formatting check passes"
profile = { kind = "runtime", command = "cargo", args = ["fmt", "--check", "-p", "artifactize-desktop"], timeout_ms = 60000 }

[evals.fmt.payload]
instruction = "Check the formatting of {desktop}."

[evals.clippy]
title = "Clippy passes for every Rust target"
profile = { kind = "runtime", command = "node", args = ["harness/harness.mts", "clippy"], timeout_ms = 1800000 }

[evals.clippy.payload]
instruction = "Build the frontend input and check every Rust target of {desktop} with {core} with {tools}, treating every clippy warning as an error."

[evals.tests]
title = "The Rust crate tests pass"
profile = { kind = "runtime", command = "node", args = ["harness/harness.mts", "test"], timeout_ms = 1800000 }

[evals.tests.payload]
instruction = "Build the frontend input and run the Rust tests of {desktop} with {core} with {tools} with {cli} with {tui}. Each fixture owns its resources even when desktop e2e runs concurrently."
