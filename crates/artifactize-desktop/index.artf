name = "desktop"
# The journeys are checked in the running app, built from this crate and the library it calls:
# all of it is an input, not only the files this declaration owns.
[fingerprint.script]
command = "node"
args = [
  "fingerprint.mjs",
  ".",
  "{core}/src",
  "{core}/Cargo.toml",
  "{tools}/src",
  "{tools}/Cargo.toml",
]

# The app runs headless for the whole review: `start` builds nothing, it needs the normal
# builds (cargo build -p artifactize -p artifactize-desktop, after pnpm build in ui/).
[views.agent_sessions.app]
start = { command = "node", args = ["harness/harness.mts", "start"], execution_paths = [
  "crates/artifactize-desktop/harness",
  "crates/artifactize-desktop/ui/e2e",
  "target/debug/artifactize-desktop",
  "target/debug/artifactize",
] }
stop = { command = "node", args = ["harness/harness.mts", "stop"], execution_paths = ["crates/artifactize-desktop/harness"] }

[views.agent_tools.snapshot]
session = "app"
description = "What the app's window shows now: its focused element, its visible controls each with a number, role, name and state, and its text."
command = "node"
args = ["harness/harness.mts", "snapshot"]
protocol = "json"

[views.agent_tools.act]
session = "app"
description = "Act in the app's window: click a control by its number from the latest snapshot, type text (into the numbered control, or the focused one), or press a key such as Enter, Escape, ArrowDown, j or Control+k. Answers with the new snapshot."
command = "node"
args = ["harness/harness.mts", "act"]
protocol = "json"

[views.agent_tools.act.input_schema]
type = "object"
properties.action = { enum = ["click", "type", "key"] }
properties.element = { type = "integer", minimum = 1, description = "Control number from the latest snapshot; required for click." }
properties.text = { type = "string", description = "Text to type; required for type." }
properties.key = { type = "string", description = "One key, or modifiers joined with + before one key; required for key." }
required = ["action"]
additionalProperties = false

[views.agent_tools.cli]
session = "app"
description = "Run the artifactize CLI against the app's repository and state from another process (for example `request list --json`, `verify --all --timeout-ms 1`, `request claim ID`), to change state the window must then show. Answers with exit code, stdout and stderr."
command = "node"
args = ["harness/harness.mts", "cli"]
protocol = "json"

[views.agent_tools.cli.input_schema]
type = "object"
properties.args = { type = "array", items = { type = "string" }, minItems = 1 }
required = ["args"]
additionalProperties = false

[evals.ready]
title = "The backend, the UI and the journeys are ready"
profile = { kind = "dependency", depends_on = ["desktop-backend", "desktop-ui", "ux-features"] }

[evals.journeys]
title = "Every journey can be completed in the running app"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 3600000, max_tokens = 32000000 }

[evals.journeys.profile_variants]
sol-medium = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "medium", timeout_ms = 3600000, max_tokens = 8000000 }
sol-max = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "max", timeout_ms = 3600000, max_tokens = 8000000 }
luna-max = { kind = "agent", backend = "codex", model = "gpt-6-luna", reasoning = "max", timeout_ms = 3600000, max_tokens = 16000000 }

[evals.journeys.payload]
instruction = """
Read the journeys {ux-features} with read_features_ux-features. The app of {desktop} is running \
headless; use snapshot_desktop to see its window, act_desktop to click, type and press keys, and \
cli_desktop to change its repository state from another process (the repository holds the Artifacts \
release, ship and docs, with a waiting Human sign-off on release). Complete every journey (J- id) \
in the running app and check that it ends in what the journey says. Journeys that need a network, \
a Codex account or a remote store (J-SET-CODEX, J-SET-MODELS, J-SET-REMOTE) are checked up to the \
point where the app asks for what it needs. Submit GREEN when every journey can be completed. \
Otherwise submit RED with up to 20 failures, the most important first, each with the journey id \
(item), what you did and saw (where) and one sentence on what to change."""

[evals.journeys.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.journeys.fail_schema]
type = "object"
required = ["failures"]
additionalProperties = false

[evals.journeys.fail_schema.properties.failures]
type = "array"
minItems = 1
maxItems = 20

[evals.journeys.fail_schema.properties.failures.items]
type = "object"
properties.item = { type = "string", minLength = 1 }
properties.where = { type = "string", minLength = 1 }
properties.change = { type = "string", minLength = 1 }
required = ["item", "where", "change"]
additionalProperties = false
