name = "desktop-ux-features"

[views.agent_tools]

[views.agent_tools.read_features]
description = "Print the user journeys UX-FEATURES.md of {artifactName}."
builtin = "read"
args = ["UX-FEATURES.md"]

[views.human_tools]
open = { description = "Open UX-FEATURES.md of {artifactName} in the desktop's default application.", builtin = "open", args = ["{artifactPath}"] }

[evals.approved]
title = "The owner approves the journeys as what the desktop app does"
profile = { kind = "human" }

[evals.approved.payload]
instruction = """
Open UX-FEATURES.md of {desktop-ux-features} with the open tool. Submit GREEN with approved: true when every journey \
is one the desktop app should offer and none is missing; otherwise submit RED and list the changes."""

[evals.approved.pass_schema]
type = "object"
properties.approved = { const = true }
properties.comment = { type = "string" }
required = ["approved"]
additionalProperties = false

[evals.approved.fail_schema]
type = "object"
properties.change = { type = "array", items = { type = "string", minLength = 1 }, minItems = 1 }
required = ["change"]
additionalProperties = false
