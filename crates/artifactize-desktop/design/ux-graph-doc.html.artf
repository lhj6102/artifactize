name = "desktop-design-graph-doc"
# The relations between the design's screens: every edge of UX-GRAPH.md placed between the
# screens it leaves and reaches, as a document people read together.

[views.agent_tools]
read = { builtin = "read" }

[evals.cites-every-edge]
title = "The graph doc places every edge of the UX graph, and no other, between known screens"
profile = { kind = "runtime", command = "node", args = ["{desktop-design-check}", "doc", "ux-graph-doc.html", "{desktop-ux-graph}"], timeout_ms = 30000 }

[evals.cites-every-edge.payload]
instruction = """
Check {desktop-design-graph-doc} with {desktop-design-check}: every edge id of {desktop-ux-graph} is cited exactly \
once, no edge is cited that the graph does not have, every screen an edge leaves or reaches is one of the design's \
screens or a terminal (start, any, quit), and every screen and terminal is described."""

[evals.places-edges]
title = "Each edge sits between the screens its From and To describe"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.places-edges.profile_variants]
sol-medium = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "medium", timeout_ms = 1800000 }

[evals.places-edges.payload]
instruction = """
Read {desktop-design-graph-doc} whole, in pages with offset and limit since it is longer than one read prints, and the UX graph {desktop-ux-graph}. The doc describes its screens (monitor, \
current, detail, review, settings, overlays) and terminals (start, any, quit) at its top, and places each edge \
between screens with data-from and data-to. Check every row: the screens it leaves are where the edge's From \
state is shown, the screens it reaches are where its To state is shown (a Run's and a Current's graphs are the \
monitor and current screens; the Detail docked over either is detail; a Human review is review in the Main area \
and detail on a Human eval's tab; the palette, Help, Open by ID, the Leave and Update dialogs and the Find field \
are overlays; Settings is settings; an edge from or to whatever view is shown uses any). Check also that the map \
and the prose do not contradict the rows. Submit GREEN when every row is placed right. Otherwise submit RED with \
up to 20 misplaced edges, each with the edge id (item), the row (where) and the screens it should name (change)."""

[evals.places-edges.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.places-edges.fail_schema]
type = "object"
required = ["findings"]
additionalProperties = false

[evals.places-edges.fail_schema.properties.findings]
type = "array"
minItems = 1
maxItems = 20

[evals.places-edges.fail_schema.properties.findings.items]
type = "object"
properties.item = { type = "string", minLength = 1 }
properties.where = { type = "string", minLength = 1 }
properties.change = { type = "string", minLength = 1 }
required = ["item", "where", "change"]
additionalProperties = false
