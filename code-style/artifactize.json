{
  "name": "code-style",
  "fingerprint": { "files": ["STYLE.md"] },
  "views": {
    "agentTools": {
      "read_style": {
        "description": "Print the code checklist STYLE.md of {artifactName}.",
        "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
        "protocol": "plain",
        "command": "cat",
        "args": ["STYLE.md"],
        "timeoutMs": 10000
      }
    },
    "humanTools": {
      "open": {
        "description": "Open STYLE.md of {artifactName} in GNOME Text Editor.",
        "kind": "launch",
        "command": "gnome-text-editor",
        "args": ["{artifactPath}/STYLE.md"]
      }
    }
  },
  "evals": [
    {
      "id": "approved",
      "title": "The owner approves the checklist as the code standard",
      "profile": { "kind": "human" },
      "payload": {
        "instruction": "Open STYLE.md of {code-style} with the open tool. Submit GREEN with approved: true when every item is one the codebase should follow; otherwise submit RED and list the items to change."
      },
      "passSchema": {
        "type": "object",
        "properties": {
          "approved": { "const": true },
          "comment": { "type": "string" }
        },
        "required": ["approved"],
        "additionalProperties": false
      },
      "failSchema": {
        "type": "object",
        "properties": {
          "change": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
        },
        "required": ["change"],
        "additionalProperties": false
      }
    }
  ]
}
