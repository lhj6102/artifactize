{
  "name": "guide",
  "mounts": {
    "terms": "glossary"
  },
  "fingerprint": {
    "files": ["."]
  },
  "evals": [
    {
      "id": "terms",
      "title": "Every bold term is defined in the glossary",
      "profile": {
        "kind": "runtime",
        "command": "python3",
        "args": [
          "check_terms.py",
          "{terms}/terms.txt",
          "{guide}/intro/page.md",
          "{usage}/page.md"
        ],
        "timeoutMs": 10000
      },
      "payload": {
        "instruction": "Check that every bold term in {intro} and {usage} is defined in {terms}."
      }
    }
  ]
}
