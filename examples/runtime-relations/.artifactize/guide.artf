artf guide = {
  parts = [intro, usage]
  path = "guide/"

  // Check that every bold term in intro and usage is defined in glossary.
  eval terms : runtime(
      command = "python3",
      args = [
        "check_terms.py",
        "@{path glossary/terms.txt}",
        "@{path intro/page.md}",
        "@{path usage/page.md}",
      ],
      timeout_ms = 10000,
    ) = {
    title = "Every bold term is defined in the glossary"
  }
}
