name = "welcome"
tags = ["type:post"]

[evals.style]
title = "The post fits in 120 words and follows the house style"
profile = { kind = "runtime", command = "python3", args = ["{house-style}/check.py", "{welcome}", "{house-style}/banned.txt", "120"], timeout_ms = 10000 }
payload.instruction = "Check that {welcome} starts with a title, stays within 120 words, and avoids every word banned in {house-style}."
