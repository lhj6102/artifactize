artf release-notes = {
  path = "release-notes.md"
  tags = ["type:post"]

  eval style : runtime(
      command = "python3",
      args = [
        "@{path house-style/check.py}",
        "@{path release-notes}",
        "@{path house-style/banned.txt}",
        "120",
      ],
      timeout_ms = 10000,
    ) = {
    title = "The post fits in 120 words and follows the house style"
    instruction = "Check that release-notes starts with a title, stays within 120 words, and avoids every word banned in house-style."
    inputs = [house-style]
  }
}
