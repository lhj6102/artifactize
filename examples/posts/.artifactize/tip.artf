artf tip = {
  path = "tip.md"
  tags = ["type:post", "length:brief"]

  eval style : runtime(
      command = "python3",
      args = [
        "@{path house-style/check.py}",
        "@{path tip}",
        "@{path house-style/banned.txt}",
        "40",
      ],
      timeout_ms = 10000,
    ) = {
    title = "The brief post fits in 40 words and follows the house style"
    instruction = "Check that tip starts with a title, stays within 40 words, and avoids every word banned in house-style."
    inputs = [house-style]
  }
}
