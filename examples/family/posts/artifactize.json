{
  "name": "posts",
  "family": {
    "instances": "instances.json",
    "params": {
      "maxWords": "120",
      "title": "The post fits in 120 words and follows the house style"
    },
    "variants": {
      "brief": {
        "maxWords": "40",
        "title": "The brief post fits in 40 words and follows the house style"
      }
    }
  },
  "mounts": {
    "style": "house-style"
  },
  "fingerprint": {
    "script": {
      "command": "python3",
      "args": ["fingerprint.py", "{style}/banned.txt"]
    }
  },
  "evals": [
    {
      "id": "style",
      "title": {"$param": "/title"},
      "profile": {
        "kind": "runtime",
        "command": "python3",
        "args": [
          "check.py",
          {"$param": "/file"},
          "{style}/banned.txt",
          {"$param": "/maxWords"}
        ],
        "timeoutMs": 10000
      },
      "payload": {
        "instruction": "Check that this post starts with a title, stays within its word limit, and avoids every word banned in {style}."
      }
    }
  ]
}
