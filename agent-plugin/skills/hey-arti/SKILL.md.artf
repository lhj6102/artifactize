name = "agent-hey-arti"
tags = ["type:skill"]

[views.agent_tools]
read = { builtin = "read" }

[views.human_tools]
open = { description = "Open SKILL.md of {artifactName} in the desktop's default application.", builtin = "open", args = ["{artifactPath}"] }

[evals.correct]
title = "What the skill recommends exists in today's artifactize"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000 }
payload.instruction = """
Read the skill {agent-hey-arti} using read_agent__hey-arti. Check that every declaration form,
command, tool, status and behaviour it mentions or recommends matches {engine-core}, {engine-cli},
{engine-mcp} and {docs-en}. Judge accuracy only: the skill need not cover every feature, and
an omission is not a finding. Submit GREEN when nothing it states is wrong or
outdated; otherwise RED with concrete skill path:line findings.
"""
pass_schema = { type = "object", properties = { summary = { type = "string", minLength = 1 } }, required = ["summary"], additionalProperties = false }
fail_schema = { type = "object", properties = { findings = { type = "array", items = { type = "string", minLength = 1 }, minItems = 1, maxItems = 20 } }, required = ["findings"], additionalProperties = false }

[evals.waiter]
title = "The skill helps the user like a restaurant's waiter"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000 }
payload.instruction = """
Read the skill {agent-hey-arti} using read_agent__hey-arti. Judge whether it helps a developer
the way a good waiter helps a guest, using {docs-en} only to understand the concepts.
It must not read as a list of artifactize's features. Check that it:
- explains each concept briefly from the user's side (what an Artifact, an eval, a
  reference, a verdict and verify mean for their project), not how artifactize
  computes them;
- knows concrete best practices for shaping Artifacts and evals, the menu: how to
  draw boundaries, which kind of eval fits which obligation, how consumers name the
  inputs they use, recurring project patterns, and the anti-patterns to steer away
  from;
- interviews the user about the project's goals, inputs and who judges what before
  proposing;
- proposes an Artifact and eval composition with reasons, the menu combination, and
  gets agreement before changing the project;
- applies the agreed changes, confirms they match artifactize's schema, and tells
  the user what changed and what will now be reviewed or reused.
Submit GREEN when it does all of these; otherwise RED with concrete skill path:line
findings, each naming the missing or misplaced part.
"""
pass_schema = { type = "object", properties = { summary = { type = "string", minLength = 1 } }, required = ["summary"], additionalProperties = false }
fail_schema = { type = "object", properties = { findings = { type = "array", items = { type = "string", minLength = 1 }, minItems = 1, maxItems = 20 } }, required = ["findings"], additionalProperties = false }

[evals.consultant]
title = "The skill reads like a Forward Deployed Engineer consulting on the project"
profile = { kind = "human" }

[evals.consultant.payload]
instruction = """
Open SKILL.md of {agent-hey-arti} with the open tool and read it as a developer meeting it \
for the first time. Submit GREEN when it reads like a Forward Deployed Engineer \
consulting on your project rather than a technical manual of artifactize; otherwise \
submit RED and list what to change."""

[evals.consultant.pass_schema]
type = "object"
properties.comment = { type = "string" }
additionalProperties = false

[evals.consultant.fail_schema]
type = "object"
properties.change = { type = "array", items = { type = "string", minLength = 1 }, minItems = 1 }
required = ["change"]
additionalProperties = false
