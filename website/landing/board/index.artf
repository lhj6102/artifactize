name = "docs::board"
# The development board at artifactize.dev/board/: reads GitHub's public API in the browser.

[views.agent_tools]
list = { builtin = "list" }
glob = { builtin = "glob" }
grep = { builtin = "grep" }
read = { builtin = "read" }

[evals.reads-the-record]
title = "The board reads the record the development skills write"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.reads-the-record.payload]
instruction = """
Read index.html, model.js and main.js of {docs::board}, and dev-master/SKILL.md and
dev-worker/SKILL.md of {dev-skills}. Check that:
- the board parses exactly the pull request note the skills tell agents to write: its
  marker, every field name, the value forms (Run IDs, outcomes, commit SHAs, times) and
  where dev-master adds `green:` lines; a note the skills describe is never dropped, and a
  malformed note never breaks the page;
- what the board derives agrees with the skills' branch model: `main`, `dev`, the
  `dev-green` tag, pull requests into `dev`, releases as `dev` into `main` plus `v*` tags,
  the roles dev-master and dev-worker, verify outcomes and CI;
- the page's description of the flow and the roles says the same as the skills;
- it uses only GitHub's public REST API without credentials, and stays usable when GitHub
  fails or its rate limit is used up.
Submit GREEN when nothing clearly disagrees or fails; otherwise RED with up to 20 findings,
each with a board path:line and one sentence on what to change in the board.
"""

[evals.reads-the-record.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.reads-the-record.fail_schema]
type = "object"
properties.findings = { type = "array", items = { type = "string", minLength = 1 }, minItems = 1, maxItems = 20 }
required = ["findings"]
additionalProperties = false

[evals.follows-rules]
title = "The board's text is plain for a first-time visitor"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.follows-rules.payload]
instruction = """
Read {rules::writer-introduction}. Read index.html of {docs::board} and the visible text that main.js
writes into it. Check the page's visible text against W-INTRO-FIRST-READER,
W-INTRO-PLAIN-LANGUAGE and W-INTRO-NO-RAMBLING; the other W- items are for the landing
page's introduction and do not apply here. Submit GREEN only when none of the three is
clearly violated. Otherwise submit RED with up to 20 violations, most important first,
each with the item id, a board path:line and one sentence on what to change in the board.
"""

[evals.follows-rules.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.follows-rules.fail_schema]
type = "object"
required = ["violations"]
additionalProperties = false

[evals.follows-rules.fail_schema.properties.violations]
type = "array"
minItems = 1
maxItems = 20

[evals.follows-rules.fail_schema.properties.violations.items]
type = "object"
properties.item = { type = "string", minLength = 1 }
properties.where = { type = "string", minLength = 1 }
properties.change = { type = "string", minLength = 1 }
required = ["item", "where", "change"]
additionalProperties = false
