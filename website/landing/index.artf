name = "docs::landing"

[views.human_tools]
preview = { description = "Open this tree's landing page in your browser with shared assets, without docs, and clean up after 30 minutes without requests.", kind = "launch", command = "python3", args = ["../preview.py"] }

[views.agent_tools]
list = { builtin = "list" }
glob = { builtin = "glob" }
grep = { builtin = "grep" }
read = { builtin = "read" }

[evals.follows-rules]
title = "The landing page follows the introduction rules"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.follows-rules.profile_variants]
sol-medium = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "medium", timeout_ms = 1800000 }
sol-max = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "max", timeout_ms = 1800000 }
luna-max = { kind = "agent", backend = "codex", model = "gpt-6-luna", reasoning = "max", timeout_ms = 1800000 }

[evals.follows-rules.payload]
instruction = """
Read {rules::writer-introduction}. Read index.html of {docs::landing}. It holds the English page and its Korean
translation: elements with data-locale="ko" and the values of data-ko-* attributes appear only on the
Korean page. Review the English page: elements without data-locale or with data-locale="en", and
attributes as written. Check its visible introduction and page content against every W- item;
installer implementation scripts are not page content.
Submit GREEN only when no item is clearly violated. Otherwise submit RED with up to 20 violations,
most important first, each with the item id, a page path:line and one sentence on what to change
in the landing page.
"""

[evals.follows-rules.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.follows-rules.fail_schema]
type = "object"
required = ["violations"]
additionalProperties = false

[evals.follows-rules.fail_schema.properties.violations]
type = "array"
minItems = 1
maxItems = 20

[evals.follows-rules.fail_schema.properties.violations.items]
type = "object"
properties.item = { type = "string", minLength = 1 }
properties.where = { type = "string", minLength = 1 }
properties.change = { type = "string", minLength = 1 }
required = ["item", "where", "change"]
additionalProperties = false

[evals.translates-ko]
title = "The Korean landing page translates the English one accurately"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.translates-ko.payload]
instruction = """
index.html of {docs::landing} holds the English landing page (served at /) and its Korean translation
(served at /ko/) in one file. The site build keeps an element with data-locale="en" only on the
English page and one with data-locale="ko" only on the Korean page, keeps elements without
data-locale on both, and on the Korean page gives an element's ATTR the value of its
data-ko-ATTR attribute. site.js writes a few words itself, in the page's language from <html lang>.
Read index.html and site.js and compare the two pages. The project sentence "Build together on an
Artifact Graph." always stays in English, on the Korean page too: as the headline, the page title,
the Open Graph title and the start of the descriptions. Check these criteria:
- K-COMPLETE: Every text a reader sees or hears on the English page has its Korean counterpart in
  the same place: headings, paragraphs, list items, links and buttons, figure captions, image alt
  text, aria-label values, the recordings' data-alt and data-label, the page title, the meta and
  Open Graph descriptions and titles, and the words site.js writes. The story's animated graphic
  (the .stage element, including the step titles it shows from data-short) stays English by
  design, as do commands, code, product names and brand names.
- K-FAITHFUL: Each Korean text has the same meaning as its English counterpart and keeps its order.
  Nothing is left out, added, softened or strengthened.
- K-SAME-TARGETS: Every Korean link reaches the same target as its English counterpart, except that
  documentation links (/docs/...) reach the same page of the Korean documentation (/docs/ko/...),
  links to the landing page reach /ko/, the hero's example graph is graph-example.ko.png, the role animation stays roles.en.gif and the
  canonical and Open Graph URLs are https://artifactize.dev/ko/. The development board (/board/)
  and the privacy page (/privacy/) are English only, and their Korean links say so. Commands, copy
  targets and code are unchanged; only comments in code may be translated. Both pages link to
  each other in the header and declare each other with hreflang.
Use the list, glob, grep and read tools of {docs::landing}. Tool paths are Artifact-relative. Judge only
whether the Korean says the same; the Korean writing and the English page are reviewed elsewhere.
Submit GREEN only when no criterion is clearly violated. Otherwise submit RED with up to 20
violations, most important first, each with the criterion id, the index.html or site.js line of the
Korean text, the line of the English text and one sentence on how to fix the Korean page.
"""

[evals.translates-ko.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.translates-ko.fail_schema]
type = "object"
required = ["violations"]
additionalProperties = false

[evals.translates-ko.fail_schema.properties.violations]
type = "array"
minItems = 1
maxItems = 20

[evals.translates-ko.fail_schema.properties.violations.items]
type = "object"
properties.item = { type = "string", minLength = 1 }
properties.translation = { type = "string", minLength = 1 }
properties.original = { type = "string", minLength = 1 }
properties.fix = { type = "string", minLength = 1 }
required = ["item", "translation", "original", "fix"]
additionalProperties = false

[evals.follows-write-in-korean]
title = "The Korean landing page follows the Korean writing rules"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.follows-write-in-korean.payload]
instruction = """
Read {rules::write-in-korean}. Read index.html and site.js of {docs::landing}. index.html holds the English and the Korean landing page in one file: the Korean page's text is in elements with data-locale=\"ko\" and in data-ko-* attribute values, and site.js writes a few Korean words from its ko table. Judge only that Korean text; the project sentence "Build together on an Artifact Graph." stays in English by design, and "Artifact Graph" is the product's name for the graph.
Check its Korean prose against every K- item. Code, commands, configuration keys, file paths,
output samples and links are not prose and are not judged; whether the Korean says the same as
the English is reviewed elsewhere. Use the list, glob, grep and read tools of {docs::landing}; tool paths are Artifact-relative.
Read every Korean sentence. Submit GREEN only when no sentence violates an item; a sentence
that is grammatical but reads as translated violates K-NATURAL. Otherwise submit RED with up
to 20 violations, most important first, each with the item id, the path:line, the text and
one sentence on how to rewrite it.
"""

[evals.follows-write-in-korean.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.follows-write-in-korean.fail_schema]
type = "object"
required = ["violations"]
additionalProperties = false

[evals.follows-write-in-korean.fail_schema.properties.violations]
type = "array"
minItems = 1
maxItems = 20

[evals.follows-write-in-korean.fail_schema.properties.violations.items]
type = "object"
properties.item = { type = "string", minLength = 1 }
properties.where = { type = "string", minLength = 1 }
properties.text = { type = "string", minLength = 1 }
properties.fix = { type = "string", minLength = 1 }
required = ["item", "where", "text", "fix"]
additionalProperties = false
