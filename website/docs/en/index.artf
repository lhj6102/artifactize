name = "docs"
fingerprint = { files = ["src"] }

[views.agent_tools]
list = { builtin = "list" }
glob = { builtin = "glob" }
grep = { builtin = "grep" }
read = { builtin = "read" }

[evals.matches-core]
title = "The documentation explains the core Artifact completely and accurately"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.matches-core.payload]
instruction = """
Review {docs} against only {core}. Start with src/SUMMARY.md in the docs.
The owned documentation area is Features (src/features/), including Artifact and its Graph, eval kinds, fingerprints and reuse, Runs, tools framework and lifecycle, team review store/CI and supporting topics. Getting Started introduces these shared features. Do not judge the endpoint-specific CLI, MCP, desktop, skill or terminal presentation here.
Check that this area is grouped in one distinct place, that all user-facing features
of the described Artifact are present, and that they are explained well and agree
with its actual behavior. Follow links within the docs for necessary context.
Use list_docs, glob_docs, grep_docs and read_docs for documentation, and the tools
exposed by {core} to inspect that Artifact. Tool paths are Artifact-relative.
Do not infer correctness from other docs or review other code Artifacts.
User-facing means what a user declares, runs, sees or must decide: declarations,
commands, flags, screens, outputs, exit codes, actionable errors and limits that
change what they can do. How artifactize implements it (process groups, signals,
journals, transactions, recovery, locking) and the Rust library API are not
user-facing. Documentation of them is a mismatch whose fix is to remove it.
Submit GREEN only when no feature is missing, poorly explained or contradicted, and
no implementation detail is documented.
Otherwise submit RED with up to 20 concrete mismatches, most misleading first,
each with the doc path:line, the implementation path:line (or skill location),
and one sentence on how to fix the documentation. Fix the docs, not the code.
"""

[evals.matches-core.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.matches-core.fail_schema]
type = "object"
required = ["mismatches"]
additionalProperties = false

[evals.matches-core.fail_schema.properties.mismatches]
type = "array"
minItems = 1
maxItems = 20

[evals.matches-core.fail_schema.properties.mismatches.items]
type = "object"
properties.doc = { type = "string", minLength = 1 }
properties.code = { type = "string", minLength = 1 }
properties.fix = { type = "string", minLength = 1 }
required = ["doc", "code", "fix"]
additionalProperties = false

