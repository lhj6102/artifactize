[evals.follows-rules]
title = "The documentation is concise, plain and written for people who use artifactize"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.follows-rules.profile_variants]
sol-medium = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "medium", timeout_ms = 1800000 }
sol-max = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "max", timeout_ms = 1800000 }
luna-max = { kind = "agent", backend = "codex", model = "gpt-6-luna", reasoning = "max", timeout_ms = 1800000 }

[evals.follows-rules.payload]
instruction = """
Review the mdBook documentation {docs} in src/, starting from src/SUMMARY.md. These are this Artifact's self-evaluation criteria:
- D-CONCISE-FEATURES: Explain the product's features concisely; unnecessary repetition and
  long-winded explanation fail this criterion.
- D-PLAIN-DOCS: A reader who is not already an expert can understand the guide. Explain
  necessary terms and commands in plain language rather than assuming professional expertise.
- D-READER: The reader uses artifactize: they declare a project, run verify, sign off, set up
  a team store or CI, or write tool Artifacts. Each page first explains what the reader does
  and what they see as a result. A paragraph that explains how artifactize implements
  something (process groups, signals, journals, transactions, recovery, locking) or the Rust
  library API violates this item; the command protocol a tool author writes against is
  user-facing.
Read every page. Submit GREEN only when no paragraph violates an item. Otherwise submit RED
with up to 20 violations, most important first, each with the item id, a documentation path:line and one
sentence on what to change in the documentation.
"""

[evals.follows-rules.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.follows-rules.fail_schema]
type = "object"
required = ["violations"]
additionalProperties = false

[evals.follows-rules.fail_schema.properties.violations]
type = "array"
minItems = 1
maxItems = 20

[evals.follows-rules.fail_schema.properties.violations.items]
type = "object"
properties.item = { type = "string", minLength = 1 }
properties.where = { type = "string", minLength = 1 }
properties.change = { type = "string", minLength = 1 }
required = ["item", "where", "change"]
additionalProperties = false
