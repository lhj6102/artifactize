name = "docs"
fingerprint = { files = ["src"] }

[views.agent_tools]
list = { builtin = "list" }
glob = { builtin = "glob" }
grep = { builtin = "grep" }
read = { builtin = "read" }

[evals.matches-cli]
title = "The documentation matches the CLI"
profile = { kind = "agent", backend = "codex", model = "gpt-6-luna", reasoning = "max", timeout_ms = 1800000, max_tool_calls = 120, max_tokens = 8000000 }

[evals.matches-cli.payload]
instruction = """
Check that the mdBook documentation in {docs} (src/, starting from src/SUMMARY.md) matches the code \
of {cli}. Compare what the docs state about commands, flags, defaults, exit codes, output, \
index.artf fields, tool declarations and state behavior with the code, using list_docs, glob_docs, \
grep_docs and read_docs for the docs and list_cli, glob_cli, grep_cli and read_cli for the code \
(start from src/cli.rs and src/config.rs). Tool paths are relative to each Artifact, for example \
src/reference/cli.md in docs. Submit GREEN when no statement clearly contradicts the code or \
describes something the code no longer has. Otherwise submit RED with up to 20 mismatches, the most \
misleading first, each with the doc path:line, the code path:line and one sentence on how to fix the \
doc."""

[evals.matches-cli.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.matches-cli.fail_schema]
type = "object"
required = ["mismatches"]
additionalProperties = false

[evals.matches-cli.fail_schema.properties.mismatches]
type = "array"
minItems = 1
maxItems = 20

[evals.matches-cli.fail_schema.properties.mismatches.items]
type = "object"
properties.doc = { type = "string", minLength = 1 }
properties.code = { type = "string", minLength = 1 }
properties.fix = { type = "string", minLength = 1 }
required = ["doc", "code", "fix"]
additionalProperties = false
