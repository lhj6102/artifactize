name = "docs"
fingerprint = { files = ["src"] }

[views.agent_tools]
list = { builtin = "list" }
glob = { builtin = "glob" }
grep = { builtin = "grep" }
read = { builtin = "read" }

[evals.matches-cli]
title = "The documentation matches the CLI"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000, max_tokens = 8000000 }

[evals.matches-cli.payload]
instruction = """
Check that the mdBook documentation in {docs} (src/, starting from src/SUMMARY.md) matches the code \
of {core}. Compare what the docs state about commands, flags, defaults, exit codes, output, \
index.artf fields, tool declarations and state behavior with the code, using list_docs, glob_docs, \
grep_docs and read_docs for the docs and list_core, glob_core, grep_core and read_core for the code \
(start from src/cli.rs, src/mcp.rs and src/config.rs). Also compare guides/hey-arti.md with the canonical \
Artifactizer skill {hey-arti}, using read_hey-arti; verify MCP-first guidance and Human/lifecycle \
boundaries agree without claiming plugin distribution. Tool paths are relative to each Artifact, for example \
src/reference/cli.md in docs. Submit GREEN when no statement clearly contradicts the code or \
describes something the code no longer has. Otherwise submit RED with up to 20 mismatches, the most \
misleading first, each with the doc path:line, the code path:line and one sentence on how to fix the \
doc."""

[evals.matches-cli.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.matches-cli.fail_schema]
type = "object"
required = ["mismatches"]
additionalProperties = false

[evals.matches-cli.fail_schema.properties.mismatches]
type = "array"
minItems = 1
maxItems = 20

[evals.matches-cli.fail_schema.properties.mismatches.items]
type = "object"
properties.doc = { type = "string", minLength = 1 }
properties.code = { type = "string", minLength = 1 }
properties.fix = { type = "string", minLength = 1 }
required = ["doc", "code", "fix"]
additionalProperties = false

[evals.follows-rules]
title = "The documentation follows the documentation rules"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000, max_tokens = 8000000 }

[evals.follows-rules.profile_variants]
sol-medium = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "medium", timeout_ms = 1800000, max_tokens = 4000000 }
sol-max = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "max", timeout_ms = 1800000, max_tokens = 4000000 }
luna-max = { kind = "agent", backend = "codex", model = "gpt-6-luna", reasoning = "max", timeout_ms = 1800000, max_tokens = 8000000 }

[evals.follows-rules.payload]
instruction = """
Read {writer-docs} with read_rules_writer-docs. Review the mdBook documentation {docs} in src/,
starting from src/SUMMARY.md, using list_docs, glob_docs, grep_docs and read_docs. Check every W-
item against every documentation page. Submit GREEN only when no item is clearly violated.
Otherwise submit RED with up to 20 violations, most important first, each with the item id,
a documentation path:line and one sentence on what to change in the documentation.
"""

[evals.follows-rules.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.follows-rules.fail_schema]
type = "object"
required = ["violations"]
additionalProperties = false

[evals.follows-rules.fail_schema.properties.violations]
type = "array"
minItems = 1
maxItems = 20

[evals.follows-rules.fail_schema.properties.violations.items]
type = "object"
properties.item = { type = "string", minLength = 1 }
properties.where = { type = "string", minLength = 1 }
properties.change = { type = "string", minLength = 1 }
required = ["item", "where", "change"]
additionalProperties = false
