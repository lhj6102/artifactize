name = "docs-ko"
fingerprint = { files = ["src"] }

[views.agent_tools]
list = { builtin = "list" }
glob = { builtin = "glob" }
grep = { builtin = "grep" }
read = { builtin = "read" }

[evals.matches-english]
title = "The Korean documentation says what the English documentation says"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.matches-english.payload]
instruction = """
Review the Korean documentation {docs-ko} as a translation of the English documentation
{docs}. Both are mdBook sources with the same chapter paths under src/; compare every English
file with the Korean file at the same path.
Check these criteria:
- K-SAME-PAGES: Every English file has a Korean file at the same path and the Korean side has no
  extra file; src/SUMMARY.md lists the same chapters in the same order and nesting.
- K-FAITHFUL: Every paragraph, list item, table cell, note and heading is translated with the
  same meaning and in the same order. Nothing is left out, added, softened or strengthened, and
  no English prose is left untranslated.
- K-SAME-TARGETS: Code blocks, commands, flags, configuration keys, file paths and output samples
  are unchanged; only comments inside code blocks and the example requests to Arti after
  /artifactize:hey-arti may be translated. Every link reaches the same
  target, except that a link to an English documentation page (/docs/...) reaches the same page
  of the Korean documentation (/docs/ko/...). Every heading of a chapter page carries its English
  heading's anchor as an explicit {#id} so that links and the language switch land on the same
  section. The part titles in src/SUMMARY.md are not page headings and have no anchor in either
  book; mdBook would show an {#id} there literally.
The project sentence "Build together on an Artifact Graph." stays in English by design, and
"Artifact Graph" is the product's name for the graph.
Judge whether the Korean says the same thing, not how it is written; the Korean writing is
reviewed elsewhere, and so is the English documentation. Use the list, glob, grep and read
tools of {docs} and {docs-ko}. Tool paths are Artifact-relative.
Submit GREEN only when no criterion is clearly violated. Otherwise submit RED with up to 20
violations, most important first, each with the criterion id, the Korean path:line, the English
path:line and one sentence on how to fix the Korean documentation.
"""

[evals.matches-english.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.matches-english.fail_schema]
type = "object"
required = ["violations"]
additionalProperties = false

[evals.matches-english.fail_schema.properties.violations]
type = "array"
minItems = 1
maxItems = 20

[evals.matches-english.fail_schema.properties.violations.items]
type = "object"
properties.item = { type = "string", minLength = 1 }
properties.translation = { type = "string", minLength = 1 }
properties.original = { type = "string", minLength = 1 }
properties.fix = { type = "string", minLength = 1 }
required = ["item", "translation", "original", "fix"]
additionalProperties = false

[evals.follows-write-in-korean]
title = "The Korean documentation follows the Korean writing rules"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.follows-write-in-korean.payload]
instruction = """
Read {write-in-korean}. Read the Korean documentation {docs-ko}, an mdBook source whose chapters are under src/.
The project sentence "Build together on an Artifact Graph." stays in English by design, and
"Artifact Graph" is the product's name for the graph.
Check its Korean prose against every K- item. Code, commands, configuration keys, file paths,
output samples and links are not prose and are not judged; whether the Korean says the same as
the English is reviewed elsewhere. Use the list, glob, grep and read tools of {docs-ko}; tool paths are Artifact-relative.
Read every Korean sentence. Submit GREEN only when no sentence violates an item; a sentence
that is grammatical but reads as translated violates K-NATURAL. Otherwise submit RED with up
to 20 violations, most important first, each with the item id, the path:line, the text and
one sentence on how to rewrite it.
"""

[evals.follows-write-in-korean.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.follows-write-in-korean.fail_schema]
type = "object"
required = ["violations"]
additionalProperties = false

[evals.follows-write-in-korean.fail_schema.properties.violations]
type = "array"
minItems = 1
maxItems = 20

[evals.follows-write-in-korean.fail_schema.properties.violations.items]
type = "object"
properties.item = { type = "string", minLength = 1 }
properties.where = { type = "string", minLength = 1 }
properties.text = { type = "string", minLength = 1 }
properties.fix = { type = "string", minLength = 1 }
required = ["item", "where", "text", "fix"]
additionalProperties = false
