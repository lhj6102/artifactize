# Shared look for the demo tapes: the promo palette, JetBrains Mono, 100 columns.
Set Shell "bash"
Set FontFamily "JetBrains Mono"
Set FontSize 16
Set LineHeight 1.25
Set Width 1000
Set Padding 22
Set WindowBar Colorful
Set WindowBarSize 36
Set BorderRadius 10
Set Margin 0
Set Framerate 20
Set TypingSpeed 40ms
Set CursorBlink false
Set Theme { "name": "artifactize", "background": "#090B0F", "foreground": "#D5DEEA", "cursor": "#3EE08F", "selection": "#262E3B", "black": "#10141B", "red": "#FF5D5D", "green": "#3EE08F", "yellow": "#F5B84B", "blue": "#6AA8FF", "purple": "#B49CFF", "cyan": "#5FE0F5", "white": "#D5DEEA", "brightBlack": "#566072", "brightRed": "#FF8080", "brightGreen": "#6BEBAA", "brightYellow": "#F8CB78", "brightBlue": "#93C0FF", "brightPurple": "#CBBBFF", "brightCyan": "#8CEBF8", "brightWhite": "#EAF0F7" }
