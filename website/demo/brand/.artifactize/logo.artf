tool design-notes = {
  human notes = builtin(
      op = "read",
      args = ["@{path self/notes.md}"],
      description = "Print the design notes for @{artf self}.",
    )
}

artf logo : design-notes = {
  path = "logo/"

  eval signoff : human = {
    title = "A designer signs off on the logo"
    instruction = "Read the design notes of @{artf logo} with the notes tool. Submit GREEN when the logo matches them; otherwise submit RED with the changes it needs."
  }

  // Check that logo/logo.svg parses as XML.
  eval svg : runtime(
      command = "python3",
      args = [
        "-c",
        "import sys, xml.dom.minidom; xml.dom.minidom.parse(sys.argv[1])",
        "logo.svg",
      ],
      timeout_ms = 10000,
    ) = {
    title = "The logo is well-formed SVG"
  }
}
