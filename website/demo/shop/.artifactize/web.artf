artf web = {
  path = "web/"

  eval colors : runtime(
      command = "python3",
      args = ["check_colors.py", "index.html", "@{path style/tokens.css}"],
      timeout_ms = 10000,
    ) = {
    title = "The page uses only defined color tokens"
    instruction = "Check that every var(--token) in web/index.html is defined in style."
  }
}
