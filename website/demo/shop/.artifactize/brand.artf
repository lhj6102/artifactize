artf brand = {
  path = "brand/"

  eval logo : runtime(
      command = "python3",
      args = [
        "-c",
        "import sys, xml.dom.minidom; xml.dom.minidom.parse(sys.argv[1])",
        "logo.svg",
      ],
      timeout_ms = 10000,
    ) = {
    title = "The logo is well-formed SVG"
    instruction = "Check that brand/logo.svg parses as XML."
  }
}
