name = "docs::readme"

[views.agent_tools.read]
builtin = "read"
args = ["README.md"]

[evals.follows-rules]
title = "The README introduces the project in the owner's flow"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.follows-rules.profile_variants]
sol-medium = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "medium", timeout_ms = 1800000 }
sol-max = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "max", timeout_ms = 1800000 }
luna-max = { kind = "agent", backend = "codex", model = "gpt-6-luna", reasoning = "max", timeout_ms = 1800000 }

[evals.follows-rules.payload]
instruction = """
Read the shared checklist {rules::writer-introduction} and the
root README {docs::readme}. Check every W- item and this Artifact's own criteria:
- R-FLOW: Badges are at the top; the exact project sentence is the first headline, followed by
  the role animation, who it is for, the example Artifact Graph image, the introduction video, the project's
  principles, a short explanation, installation, and real product screenshots at the bottom. The role
  animation and the example graph are the English images rendered in assets/others/ (roles.en.gif
  and graph-example.en.png), referenced by those paths.
- R-INSTALL-OS: The README guides installation itself by operating system. Default methods
  per OS plus a pointer to alternatives are sufficient. It must not replace those defaults
  with only a link to the docs installation page.
- R-REAL-SCREENS: This covers the product images at the bottom; the role animation, the
  example graph and the introduction video near the top are R-FLOW's. The README may attach the screenshots in assets/screenshots/ and the
  demos in assets/demos/, which are captured from the real app. It references them by
  those paths, never as copies elsewhere. Example data
  is labeled as such and must not present fabricated Human approvals as genuine.
Submit GREEN only when no shared item or own criterion is clearly violated. Otherwise submit
RED with up to 20 violations, most important first, each with the item id, a README path:line
and one sentence on what to change in the README.
"""

[evals.follows-rules.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.follows-rules.fail_schema]
type = "object"
required = ["violations"]
additionalProperties = false

[evals.follows-rules.fail_schema.properties.violations]
type = "array"
minItems = 1
maxItems = 20

[evals.follows-rules.fail_schema.properties.violations.items]
type = "object"
properties.item = { type = "string", minLength = 1 }
properties.where = { type = "string", minLength = 1 }
properties.change = { type = "string", minLength = 1 }
required = ["item", "where", "change"]
additionalProperties = false

[evals.matches-landing-install]
title = "The README's installation matches the landing page's install section"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "high", timeout_ms = 1800000 }

[evals.matches-landing-install.payload]
instruction = """
Read the installation section of the root README {docs::readme} and the install section of index.html
of {docs::landing}. For each operating system (Linux, macOS, Windows), compare what the two tell a
reader to do: the default install command must be identical, an alternative method both name
must be the same, and both must agree on which channels are not available yet. Wording and
layout may differ, and either may mention a detail the other leaves out as long as nothing
contradicts.
Submit GREEN when they agree. Otherwise submit RED with one finding per mismatch, naming the
operating system, the README path:line and the landing page path:line, and one sentence on what to
change in the README.
"""

[evals.matches-landing-install.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.matches-landing-install.fail_schema]
type = "object"
required = ["findings"]
additionalProperties = false

[evals.matches-landing-install.fail_schema.properties.findings]
type = "array"
minItems = 1
maxItems = 10

[evals.matches-landing-install.fail_schema.properties.findings.items]
type = "object"
properties.os = { type = "string", minLength = 1 }
properties.readme = { type = "string", minLength = 1 }
properties.landing = { type = "string", minLength = 1 }
properties.change = { type = "string", minLength = 1 }
required = ["os", "readme", "landing", "change"]
additionalProperties = false
