name = "readme"

[views.agent_tools.read]
builtin = "read"
args = ["README.md"]

[evals.follows-rules]
title = "The README introduces the project in the owner's flow"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.follows-rules.profile_variants]
sol-medium = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "medium", timeout_ms = 1800000 }
sol-max = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "max", timeout_ms = 1800000 }
luna-max = { kind = "agent", backend = "codex", model = "gpt-6-luna", reasoning = "max", timeout_ms = 1800000 }

[evals.follows-rules.payload]
instruction = """
Read the shared checklist {writer-introduction} and the
root README {readme}. Check every W- item and this Artifact's own criteria:
- R-FLOW: Badges are at the top; the exact project sentence is the first headline, followed by
  the core hook and introduction video, a short explanation, installation, and real product
  screenshots at the bottom.
- R-INSTALL-OS: The README guides installation itself by operating system. Default methods
  per OS plus a pointer to alternatives are sufficient. It must not replace those defaults
  with only a link to the docs installation page.
- R-REAL-SCREENS: The README may attach the screenshots in assets/screenshots/ and the
  demos in assets/demos/, which are captured from the real app. It references them by
  those paths, never as copies elsewhere, and shows no other product images. Example data
  is labeled as such and must not present fabricated Human approvals as genuine.
Submit GREEN only when no shared item or own criterion is clearly violated. Otherwise submit
RED with up to 20 violations, most important first, each with the item id, a README path:line
and one sentence on what to change in the README.
"""

[evals.follows-rules.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.follows-rules.fail_schema]
type = "object"
required = ["violations"]
additionalProperties = false

[evals.follows-rules.fail_schema.properties.violations]
type = "array"
minItems = 1
maxItems = 20

[evals.follows-rules.fail_schema.properties.violations.items]
type = "object"
properties.item = { type = "string", minLength = 1 }
properties.where = { type = "string", minLength = 1 }
properties.change = { type = "string", minLength = 1 }
required = ["item", "where", "change"]
additionalProperties = false
