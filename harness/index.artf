name = "arti-onramp"

[views.agent_tools]
list = { builtin = "list" }
glob = { builtin = "glob" }
grep = { builtin = "grep" }
read = { builtin = "read" }

[evals.follows-test-rules]
title = "The onramp's Python tests and harness entry points follow the test rules"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.follows-test-rules.payload]
instruction = """
Read the TEST- rules of {code-style} with read_style_code-style. Review the Python tests and harness \
entry points directly owned by {arti-onramp}, using list_arti-onramp, glob_arti-onramp, grep_arti-onramp \
and read_arti-onramp. The nested {arti-harness} has its own test-rule review: do not duplicate it. \
Check every TEST- rule against observable boundaries, exact async states, controlled ordering or \
expiry times, read-only observations, owned cleanup, and declared executables and inputs. Submit \
GREEN when none is clearly violated. Otherwise submit RED with up to 20 violations, each with the \
TEST- rule id (item), a path:line (where), and one sentence on what to change.
"""

[evals.follows-test-rules.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.follows-test-rules.fail_schema]
type = "object"
properties.violations = { type = "array", minItems = 1, maxItems = 20, items = { type = "object", properties = { item = { type = "string", minLength = 1 }, where = { type = "string", minLength = 1 }, change = { type = "string", minLength = 1 } }, required = ["item", "where", "change"], additionalProperties = false } }
required = ["violations"]
additionalProperties = false
