name = "agent-plugin"
tags = ["type:plugin"]

# This folder is the plugin both hosts install: their manifests, Codex's MCP file
# and the hey-arti skill folder, which has its own reviews.

[views.agent_tools]
list = { builtin = "list" }
glob = { builtin = "glob" }
read = { builtin = "read" }

[evals.claude-code-installs]
title = "Claude Code installs the plugin with its skill and MCP server"
profile = { kind = "runtime", command = "python3", args = ["-I", "{arti-onramp}/agent_plugin.py", "claude", "{agent-plugin}", "{claude-marketplace}"], timeout_ms = 600000 }
payload.instruction = "Install {agent-plugin} from {claude-marketplace} into a disposable configuration of the installed Claude Code, and check that it validates and loads every skill of the folder and the artifactize MCP server for the session's project."

[evals.codex-installs]
title = "Codex installs the plugin with its skill and MCP server"
profile = { kind = "runtime", command = "python3", args = ["-I", "{arti-onramp}/agent_plugin.py", "codex", "{agent-plugin}", "{codex-marketplace}"], timeout_ms = 600000 }
payload.instruction = "Install {agent-plugin} from {codex-marketplace} into a disposable configuration of the installed Codex, and check that it loads every skill of the folder and the artifactize MCP server for the session's project."
