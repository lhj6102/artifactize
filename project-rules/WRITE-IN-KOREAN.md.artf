name = "write-in-korean"

[views.agent_tools]

[views.agent_tools.read_rules]
description = "Print the Korean writing rules WRITE-IN-KOREAN.md of {artifactName}."
builtin = "read"
args = ["WRITE-IN-KOREAN.md"]

[views.human_tools]
open = { description = "Open WRITE-IN-KOREAN.md of {artifactName} in the desktop's default application.", builtin = "open", args = ["{artifactPath}"] }

[evals.follows-itself]
title = "The Korean writing rules follow themselves"
profile = { kind = "agent", backend = "codex", model = "gpt-6.1-sol", reasoning = "xhigh", timeout_ms = 1800000 }

[evals.follows-itself.payload]
instruction = """
Read WRITE-IN-KOREAN.md of {write-in-korean} with the read_rules tool. It states rules for Korean writing and \
is itself written in Korean. Read every Korean sentence of it, including the examples, and check it against \
every K- item of the same document. The item ids, the English words quoted as examples and the phrases quoted in '…' \
as what not to write are not prose to judge. Submit GREEN only when no sentence violates an item. Otherwise submit RED with up to 20 violations, \
each with the item id, the line, the text and one sentence on how to rewrite it."""

[evals.follows-itself.pass_schema]
type = "object"
properties.summary = { type = "string", minLength = 1 }
required = ["summary"]
additionalProperties = false

[evals.follows-itself.fail_schema]
type = "object"
required = ["violations"]
additionalProperties = false

[evals.follows-itself.fail_schema.properties.violations]
type = "array"
minItems = 1
maxItems = 20

[evals.follows-itself.fail_schema.properties.violations.items]
type = "object"
properties.item = { type = "string", minLength = 1 }
properties.where = { type = "string", minLength = 1 }
properties.text = { type = "string", minLength = 1 }
properties.fix = { type = "string", minLength = 1 }
required = ["item", "where", "text", "fix"]
additionalProperties = false

[evals.approved]
title = "The owner approves the rules as the Korean writing standard"
profile = { kind = "human" }

[evals.approved.payload]
instruction = """
Open WRITE-IN-KOREAN.md of {write-in-korean} with the open tool. Submit GREEN with approved: true when every rule \
is one the project's Korean writing should follow; otherwise submit RED and list the items to change."""

[evals.approved.pass_schema]
type = "object"
properties.approved = { const = true }
properties.comment = { type = "string" }
required = ["approved"]
additionalProperties = false

[evals.approved.fail_schema]
type = "object"
properties.change = { type = "array", items = { type = "string", minLength = 1 }, minItems = 1 }
required = ["change"]
additionalProperties = false
