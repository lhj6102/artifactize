name = "rules-code-style"

[views.agent_tools]

[views.agent_tools.read_style]
description = "Print the code checklist DEV-CODING.md of {artifactName}."
builtin = "read"
args = ["DEV-CODING.md"]

[views.human_tools]
open = { description = "Open DEV-CODING.md of {artifactName} in the desktop's default application.", builtin = "open", args = ["{artifactPath}"] }

[evals.approved]
title = "The owner approves the checklist as the code standard"
profile = { kind = "human" }

[evals.approved.payload]
instruction = """
Open DEV-CODING.md of {rules-code-style} with the open tool. Submit GREEN with approved: true when every item \
is one the codebase should follow; otherwise submit RED and list the items to change."""

[evals.approved.pass_schema]
type = "object"
properties.approved = { const = true }
properties.comment = { type = "string" }
required = ["approved"]
additionalProperties = false

[evals.approved.fail_schema]
type = "object"
properties.change = { type = "array", items = { type = "string", minLength = 1 }, minItems = 1 }
required = ["change"]
additionalProperties = false
